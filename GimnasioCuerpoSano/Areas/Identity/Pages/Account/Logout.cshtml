@page
@model LogoutModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Cerrar Sesión - Gimnasio Cuerpo Sano</title>
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="container">
        <h1>Cerrar Sesión</h1>

        <p class="text-center">¿Seguro que deseas cerrar la sesión actual?</p>

        <form class="text-center mt-4" method="post">
            <button type="submit" class="btn btn-danger">Cerrar Sesión</button>
            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</body>
</html>

