@page
@model RegisterModel
@{
    Layout = null;
    ViewData["Title"] = "Registro de Usuario";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gimnasio Cuerpo Sano</title>
    <link rel="icon" type="image/x-icon" href="~/img/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            background-color: #f3f4f6;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .register-container {
            width: 100%;
            max-width: 450px;
            background: #fff;
            padding: 2rem;
            border-radius: 15px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
        }

        h2 {
            text-align: center;
            color: #198754;
            margin-bottom: 1.5rem;
            font-weight: 600;
        }

        .form-floating label {
            color: #555;
        }

        .btn-success {
            background-color: #198754;
            border: none;
            font-weight: 600;
        }

            .btn-success:hover {
                background-color: #157347;
            }

        .alert ul {
            margin: 0;
            padding-left: 20px;
        }

        .text-danger {
            font-size: 0.9rem;
        }

        .footer-text {
            text-align: center;
            font-size: 0.85rem;
            color: #666;
            margin-top: 1rem;
        }

            .footer-text a {
                color: #198754;
                text-decoration: none;
            }

                .footer-text a:hover {
                    text-decoration: underline;
                }

        .input-group .btn-outline-secondary {
            border-color: #dee2e6;
            border-top-left-radius: 0;
            border-bottom-left-radius: 0;
            height: 58px;
            padding-top: 1rem;
        }

        .input-group .text-danger {
            margin-top: 0.25rem;
        }
    </style>
</head>

<body>
    <div class="register-container">
        <h2>Crear nueva cuenta</h2>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger text-center" role="alert">
                <strong>Ocurrió un problema:</strong>
                <ul class="text-start mb-0 mt-2">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        @* Mensaje opcional según tipo de usuario *@
        @if (ViewData["UserTypeMessage"] != null)
        {
            <div class="alert alert-info text-center">
                @ViewData["UserTypeMessage"]
            </div>
        }

        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div class="form-floating mb-3">
                <input asp-for="Input.DNI" class="form-control" aria-required="true" placeholder="Ingrese su DNI" />
                <label asp-for="Input.DNI">DNI</label>
                <span asp-validation-for="Input.DNI" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <label asp-for="Input.Email">Correo electrónico</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="input-group mb-3">
                <div class="form-floating flex-grow-1">
                    <input asp-for="Input.Password" type="password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Contraseña" id="passwordInput" />
                    <label for="passwordInput">Contraseña</label>
                </div>
                <button class="btn btn-outline-secondary" type="button" id="togglePassword" title="Mostrar/Ocultar Contraseña">
                    <i class="bi bi-eye-slash" id="toggleIcon"></i>
                </button>
                <span asp-validation-for="Input.Password" class="text-danger w-100"></span>
            </div>

            <div class="input-group mb-4">
                <div class="form-floating flex-grow-1">
                    <input asp-for="Input.ConfirmPassword" type="password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Confirmar contraseña" id="confirmPasswordInput" />
                    <label for="confirmPasswordInput">Confirmar contraseña</label>
                </div>
                <button class="btn btn-outline-secondary" type="button" id="toggleConfirmPassword" title="Mostrar/Ocultar Confirmación">
                    <i class="bi bi-eye-slash" id="toggleConfirmIcon"></i>
                </button>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger w-100"></span>
            </div>

            <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-success">Registrarme</button>
        </form>

        <div class="footer-text">
            ¿Ya tenés cuenta? <a asp-page="/Account/Login">Iniciar sesión</a>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {

            function togglePasswordVisibility(buttonId, inputId, iconId) {
                const toggleButton = document.getElementById(buttonId);
                const passwordInput = document.getElementById(inputId);
                const toggleIcon = document.getElementById(iconId);

                if (toggleButton && passwordInput && toggleIcon) {
                    toggleButton.addEventListener('click', function () {
                        const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
                        passwordInput.setAttribute('type', type);
                        if (type === 'text') {
                            toggleIcon.classList.remove('bi-eye-slash');
                            toggleIcon.classList.add('bi-eye');
                        } else {
                            toggleIcon.classList.remove('bi-eye');
                            toggleIcon.classList.add('bi-eye-slash');
                        }
                    });
                }
            }

            togglePasswordVisibility('togglePassword', 'passwordInput', 'toggleIcon');
            togglePasswordVisibility('toggleConfirmPassword', 'confirmPasswordInput', 'toggleConfirmIcon');
        });
    </script>
</body>
</html>
