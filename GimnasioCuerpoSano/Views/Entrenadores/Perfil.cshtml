@model GimnasioCuerpoSano.Models.Entrenador

@{
    ViewData["Title"] = "Perfil del Entrenador";
    Layout = "_Layout"; // o Layout = null; si querés una página aislada
}

<div class="container mt-5">
    <div class="card shadow-lg rounded-4">
        <div class="card-header bg-primary text-white text-center rounded-top">
            <h3>@Model.Nombre @Model.Apellido</h3>
            <h5 class="mb-0">Perfil del Entrenador</h5>
        </div>

        <div class="card-body">
            <div class="row">
                <!-- Datos del entrenador -->
                <div class="col-md-6">
                    <h5 class="text-secondary mb-3"><i class="bi bi-person-badge"></i> Información Personal</h5>
                    <p><strong>Tipo Documento:</strong> @Model.TipoDocumento</p>
                    <p><strong>DNI:</strong> @Model.DNI</p>
                    <p><strong>Email:</strong> @Model.Email</p>
                    <p><strong>Teléfono:</strong> @Model.Telefono</p>
                    <p><strong>Dirección:</strong> @Model.Direccion</p>
                    <p><strong>Especialidad:</strong> @Model.Especialidad</p>
                </div>

                <!-- Certificado -->
                <div class="col-md-6">
                    <h5 class="text-secondary mb-3"><i class="bi bi-award"></i> Certificación</h5>
                    <p>
                        <strong>Fecha de Vencimiento:</strong>
                        @Model.FechaVencimientoCertificado?.ToString("dd/MM/yyyy")
                    </p>

                    @if (!string.IsNullOrEmpty(Model.RutaCertificado))
                    {
                        <p>
                            <a href="@Model.RutaCertificado" target="_blank" class="btn btn-outline-primary">
                                <i class="bi bi-file-earmark-pdf"></i> Ver Certificado
                            </a>
                        </p>
                    }
                    else
                    {
                        <p class="text-danger">Sin certificado cargado.</p>
                    }
                </div>
            </div>

            <hr />

            <!-- Clases que dicta -->
            <div class="mt-4">
                <h5 class="text-secondary mb-3"><i class="bi bi-calendar-check"></i> Clases Asignadas</h5>

                @if (Model.Clases != null && Model.Clases.Any())
                {
                    <table class="table table-bordered table-hover">
                        <thead class="table-primary">
                            <tr>
                                <th>Nombre</th>
                                <th>Duración (min)</th>
                                <th>Precio</th>
                                <th>Sala</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var clase in Model.Clases)
                            {
                                <tr>
                                    <td>@clase.Nombre</td>
                                    <td>@clase.DuracionMinutos</td>
                                    <td>@clase.Precio.ToString("C")</td>
                                    <td>@clase.Sala?.Numero</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted">No tiene clases asignadas actualmente.</p>
                }
            </div>
        </div>

        <div class="card-footer text-center">
            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left-circle"></i> Volver al inicio
            </a>
        </div>
    </div>
</div>
