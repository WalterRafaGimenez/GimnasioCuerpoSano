@model GimnasioCuerpoSano.Models.Entrenador

@{
    Layout = null;
    ViewData["Title"] = "Detalles del Entrenador";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body {
            background-color: #f8f9fa;
            padding: 2rem;
            font-family: 'Segoe UI', sans-serif;
        }

        h2 {
            color: #0d6efd;
            margin-bottom: 1.5rem;
        }

        .card {
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            padding: 2rem;
            background: white;
            max-width: 600px;
            margin: auto;
        }

        .btn {
            border-radius: 8px;
        }

        .info-row {
            margin-bottom: 0.75rem;
        }

        .label {
            font-weight: 600;
            color: #212529;
        }

        .value {
            color: #495057;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="card">
            <h2 class="text-center">Detalles del Entrenador</h2>

            <div class="info-row">
                <span class="label">Tipo Documento:</span>
                <span class="value">@Model.TipoDocumento</span>
            </div>

            <div class="info-row">
                <span class="label">DNI:</span>
                <span class="value">@Model.DNI</span>
            </div>

            <div class="info-row">
                <span class="label">Nombre:</span>
                <span class="value">@Model.Nombre</span>
            </div>

            <div class="info-row">
                <span class="label">Apellido:</span>
                <span class="value">@Model.Apellido</span>
            </div>

            <div class="info-row">
                <span class="label">Dirección:</span>
                <span class="value">@Model.Direccion</span>
            </div>

            <div class="info-row">
                <span class="label">Teléfono:</span>
                <span class="value">@Model.Telefono</span>
            </div>

            <div class="info-row">
                <span class="label">Email:</span>
                <span class="value">@Model.Email</span>
            </div>

            <div class="info-row">
                <span class="label">Especialidad:</span>
                <span class="value">@Model.Especialidad</span>
            </div>

            <div class="info-row">
                <span class="label">Vencimiento Certificado:</span>
                <span class="value">@Model.FechaVencimientoCertificado?.ToString("dd/MM/yyyy")</span>
            </div>

            @if (!string.IsNullOrEmpty(Model.RutaCertificado))
            {
                <div class="info-row">
                    <a href="@Model.RutaCertificado" target="_blank" class="btn btn-secondary">Ver Certificado</a>
                </div>
            }

            <div class="text-center mt-4">
                <a asp-action="Index" class="btn btn-primary px-4">Volver al listado</a>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning px-4 ms-2">Editar</a>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

