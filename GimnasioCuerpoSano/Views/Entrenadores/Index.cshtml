@model IEnumerable<GimnasioCuerpoSano.Models.Entrenador>

@{
    Layout = null;
    ViewData["Title"] = "Listado de Entrenadores";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gimnasio Cuerpo Sano</title>
    <link rel="icon" type="image/x-icon" href="~/img/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" />

    <style>
                body {
                        background-color: #f8f9fa;
                        font-family: 'Segoe UI', sans-serif;
                        padding: 2rem;

        }


        /* 🟢 UNIFICADO: Estilos para el Encabezado y Logo 🟢 */
                .main-header {
                        text-align: center;
                        margin-top: 1rem;
                        margin-bottom: 2rem;

        }

                    .main-header .page-title {
                            color: #212529; /* Título oscuro para la consistencia */
                            font-weight: 700;
                            margin-top: 0.5rem;
                            font-size: 2rem;

        }


        /* Estilo para el contenedor más amplio */
                .wide-container {
                        max-width: 1300px;
                        margin: 0 auto; /* Centra el contenedor */
                        padding: 0 15px;

        }


        /* 🟢 UNIFICADO: Estilo para la tarjeta/card 🟢 */
                .card {
                        border-radius: 12px;
                        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
                        background: white;
                        overflow: hidden;

        }

                table {
                        border-radius: 10px;
                        overflow: hidden;

        }


        /* 🎨 CAMBIO CLAVE: Estilo de cabecera de tabla: Gris Claro y Letras Negras 🎨 */
                thead th {
                        **background-color: #f1f3f5 !important; /* Gris Claro */
            **             **color: #212529 !important; /* Texto Negro */
            **             text-transform: uppercase;
                        letter-spacing: 0.5px;
                        font-size: 0.9rem;
                        font-weight: 600; /* Aseguramos que sea negrita */
                        vertical-align: middle;

        }

                tbody tr:hover {
                        background-color: #f1f3f5;
                        transition: 0.2s;

        }


        /* Fuerza a que los botones se queden en una sola línea y minimiza el ancho */
                .table td.actions {
                        white-space: nowrap;
                        width: 1%;
                        padding: 0.5rem;

        }


        /* Estilo para los botones principales fuera de la tabla */
                .top-buttons {
                        text-align: center;
                        margin-bottom: 1.5rem;
                        margin-top: 1rem;

        }

                .btn {
                        border-radius: 8px;
                        font-weight: 500;
                        margin: 0.2rem;

        }


    </style>
</head>
<body>

    @* 🟢 UNIFICADO: Logo y Título Principal 🟢 *@
    <div class="main-header">
        <img src="~/img/Logo.png" alt="Logo Cuerpo Sano" style="width: 100px; height: auto;" />
        <h1 class="page-title">@ViewData["Title"]</h1>
    </div>

    <div class="wide-container">
        <div class="card shadow-lg">

            <div class="card-body">

                @* Botones superiores (usando la clase top-buttons) *@
                <div class="top-buttons">
                    <a asp-action="Create" class="btn btn-success">
                        <i class="bi bi-person-plus"></i> Alta Entrenador
                    </a>

                    <a asp-action="GenerarListadoPdf" class="btn btn-primary" target="_blank">
                        <i class="bi bi-file-earmark-pdf"></i> Imprimir Listado PDF
                    </a>
                    <a href="/" class="btn btn-secondary">
                        <i class="bi bi-house-door"></i> Volver
                    </a>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered table-striped align-middle text-center shadow-sm mb-0">
                        <thead>
                            <tr>
                                <th>Tipo Doc.</th>
                                <th>DNI</th>
                                <th>Nombre</th>
                                <th>Apellido</th>
                                <th>Especialidad</th>
                                <th>Teléfono</th>
                                <th>Email</th>
                                <th>Venc. Certificado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entrenador in Model)
                            {
                                <tr>
                                    <td>@entrenador.TipoDocumento</td>
                                    <td>@entrenador.DNI</td>
                                    <td>@entrenador.Nombre</td>
                                    <td>@entrenador.Apellido</td>
                                    <td>@entrenador.Especialidad</td>
                                    <td>@entrenador.Telefono</td>
                                    <td>@entrenador.Email</td>
                                    <td>@entrenador.FechaVencimientoCertificado?.ToString("yyyy-MM-dd")</td>
                                    <td class="actions">



                                        <a asp-action="Edit" asp-route-id="@entrenador.Id" class="btn btn-primary btn-sm me-1">
                                            <i class="bi bi-pencil"></i> Editar
                                        </a>

                                        <a asp-action="Details" asp-route-id="@entrenador.Id" class="btn btn-info btn-sm me-1">
                                            <i class="bi bi-eye"></i> Ver
                                        </a>

                                        <a asp-action="Delete" asp-route-id="@entrenador.Id" class="btn btn-danger btn-sm me-1">
                                            <i class="bi bi-trash"></i> Eliminar
                                        </a>

                                       
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>