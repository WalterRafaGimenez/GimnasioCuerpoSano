@model IEnumerable<GimnasioCuerpoSano.Models.Entrenador>
@{
    Layout = null;
    ViewData["Title"] = "Listado de Entrenadores";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/lib/bootstrap-icons/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="container mt-4">
        <div class="card shadow-lg">
            <div class="card-header bg-primary text-white text-center">
                <h4>@ViewData["Title"]</h4>
            </div>
            <div class="card-body">
                <div class="mb-3 text-center">
                    <a asp-action="Create" class="btn btn-success me-2">
                        <i class="bi bi-person-plus"></i> Alta de Entrenador
                    </a>
                    <a href="/" class="btn btn-secondary">
                        <i class="bi bi-house-door"></i> Volver al Menú
                    </a>
                </div>

                <table class="table table-bordered table-striped align-middle text-center">
                    <thead class="table-dark">
                        <tr>
                            <th>Nombre</th>
                            <th>Apellido</th>
                            <th>Especialidad</th>
                            <th>Teléfono</th>
                            <th>Email</th>
                            <th>Venc. Certificado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entrenador in Model)
                        {
                            <tr>
                                <td>@entrenador.Nombre</td>
                                <td>@entrenador.Apellido</td>
                                <td>@entrenador.Especialidad</td>
                                <td>@entrenador.Telefono</td>
                                <td>@entrenador.Email</td>
                                <td>@entrenador.FechaVencimientoCertificado?.ToString("yyyy-MM-dd")</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@entrenador.Id" class="btn btn-info btn-sm me-1">
                                        <i class="bi bi-eye"></i> Ver
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@entrenador.Id" class="btn btn-warning btn-sm me-1">
                                        <i class="bi bi-pencil"></i> Editar
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@entrenador.Id" class="btn btn-danger btn-sm me-1">
                                        <i class="bi bi-trash"></i> Eliminar
                                    </a>
                                    @if (!string.IsNullOrEmpty(entrenador.RutaCertificado))
                                    {
                                        <a href="@entrenador.RutaCertificado" target="_blank" class="btn btn-secondary btn-sm">
                                            <i class="bi bi-file-earmark-pdf"></i> Ver Certificado
                                        </a>
                                    }

                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="text-center mt-3">
                    <a href="/" class="btn btn-primary">
                        <i class="bi bi-house-door"></i> Volver al Menú
                    </a>
                </div>
            </div>
        </div>
    </div>

    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>





