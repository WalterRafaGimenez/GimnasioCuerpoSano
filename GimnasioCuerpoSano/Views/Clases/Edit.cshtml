@model GimnasioCuerpoSano.Models.Clase

@{
    Layout = null;
    ViewData["Title"] = "Editar Clase";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Editar Clase - Gimnasio Cuerpo Sano</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="container">
        <h1>Editar Clase</h1>

        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group">
                <label>Nombre de la Clase</label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Precio</label>
                <input asp-for="Precio" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="Precio" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Duración (en minutos)</label>
                <input asp-for="DuracionMinutos" type="number" class="form-control" />
                <span asp-validation-for="DuracionMinutos" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Entrenador</label>
                <select asp-for="EntrenadorId" class="form-control">
                    <option value="">-- Seleccione un entrenador --</option>
                    @foreach (var entrenador in ViewBag.Entrenadores)
                    {
                        <option value="@entrenador.Id" selected="@(entrenador.Id == Model.EntrenadorId)">
                            @($"{entrenador.Nombre} {entrenador.Apellido}")
                        </option>
                    }
                </select>
                <span asp-validation-for="EntrenadorId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Sala</label>
                <select asp-for="SalaId" class="form-control">
                    <option value="">-- Seleccione una sala --</option>
                    @foreach (var sala in ViewBag.Salas)
                    {
                        <option value="@sala.ID_Sala" selected="@(sala.ID_Sala == Model.SalaId)">
                            @sala.Nombre
                        </option>
                    }
                </select>
                <span asp-validation-for="SalaId" class="text-danger"></span>
            </div>

            <div class="text-center mt-4">
                <button type="submit" class="btn btn-success px-4">Guardar Cambios</button>
                <a asp-action="Index" class="btn btn-secondary px-4 ms-2">Volver</a>
            </div>
        </form>
    </div>
</body>
</html>

