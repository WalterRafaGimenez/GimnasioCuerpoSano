@model GimnasioCuerpoSano.Models.Clase

@{
    Layout = null;
    ViewData["Title"] = "Editar Clase";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body {
            background-color: #f8f9fa;
            padding: 2rem;
            font-family: 'Segoe UI', sans-serif;
        }

        .card-form {
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            background: white;
            padding: 2rem;
            max-width: 600px;
            margin: auto;
        }

        h2 {
            color: #0d6efd;
            margin-bottom: 2rem;
            text-align: center;
        }

        .form-label {
            font-weight: bold;
        }

        .value-box {
            background-color: #f1f3f5;
            border-radius: 6px;
            padding: 0.5rem 1rem;
            margin-bottom: 1rem;
        }

        .btn {
            border-radius: 8px;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="card-form">
            <h2>@ViewData["Title"]</h2>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">@ViewBag.Error</div>
            }
            @if (ViewBag.Advertencia != null)
            {
                <div class="alert alert-warning">@ViewBag.Advertencia</div>
            }

            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label"></label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Precio" class="form-label"></label>
                    <input asp-for="Precio" class="form-control" type="number" step="0.01" min="0" />
                    <span asp-validation-for="Precio" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="DuracionMinutos" class="form-label">Duración (minutos)</label>
                    <input asp-for="DuracionMinutos" id="duracionInput" class="form-control" type="number" min="1" max="600" />
                    <span asp-validation-for="DuracionMinutos" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="EntrenadorId" class="form-label">Entrenador</label>
                    <select asp-for="EntrenadorId" asp-items="ViewBag.Entrenadores" class="form-select">
                        <option value="0">-- Seleccione un entrenador --</option>
                    </select>
                    <span asp-validation-for="EntrenadorId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="SalaId" class="form-label">Sala</label>
                    <select asp-for="SalaId" asp-items="ViewBag.Salas" class="form-select">
                        <option value="0">-- Seleccione una sala --</option>
                    </select>
                    <span asp-validation-for="SalaId" class="text-danger"></span>
                </div>

                <div class="text-center mt-4">
                    <button type="submit" class="btn btn-success px-4">Guardar</button>
                    <a asp-action="Index" class="btn btn-secondary px-4 ms-2">Volver</a>
                </div>
            </form>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        // Solo permitir números enteros en DuracionMinutos
        const duracionInput = document.getElementById('duracionInput');
        if (duracionInput) {
            duracionInput.addEventListener('input', () => {
                duracionInput.value = duracionInput.value.replace(/\D/g, '');
            });
        }
    </script>
</body>
</html>

