@model IEnumerable<GimnasioCuerpoSano.Models.Clase>

@{
    Layout = null;
    ViewData["Title"] = "Listado de Clases";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Listado de Clases - Gimnasio Cuerpo Sano</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="container">
        <h1>Listado de Clases</h1>

        <div class="text-end mb-3">
            <a asp-action="Create" class="btn btn-success px-4">Nueva Clase</a>
            </a>
            <a asp-action="GenerarListadoPdf" class="btn btn-success" target="_blank">
                <i class="bi bi-file-earmark-pdf"></i> Imprimir Listado PDF
            </a>
        </div>

        @if (Model != null && Model.Any())
        {
            <table class="table table-striped table-bordered">
                <thead class="table-light">
                    <tr>
                        <th>Nombre</th>
                        <th>Entrenador</th>
                        <th>Sala</th>
                        <th>Precio</th>
                        <th>Duración (min)</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var clase in Model)
                    {
                        <tr>
                            <td>@clase.Nombre</td>
                            <td>@(clase.Entrenador != null ? $"{clase.Entrenador.Nombre} {clase.Entrenador.Apellido}" : "—")</td>
                            <td>@(clase.Sala != null ? clase.Sala.Nombre : "—")</td>
                            <td>$@clase.Precio</td>
                            <td>@clase.DuracionMinutos</td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@clase.Id" class="btn btn-primary btn-sm">Editar</a>
                                <a asp-action="Details" asp-route-id="@clase.Id" class="btn btn-info btn-sm text-white">Detalles</a>
                                <a asp-action="Delete" asp-route-id="@clase.Id" class="btn btn-danger btn-sm">Eliminar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-center mt-4">No hay clases registradas.</p>
        }

        <div class="text-center mt-4">
            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary px-4">Volver al Inicio</a>
        </div>
    </div>
</body>
</html>
