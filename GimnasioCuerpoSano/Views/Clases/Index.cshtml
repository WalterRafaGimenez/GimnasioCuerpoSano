@model IEnumerable<GimnasioCuerpoSano.Models.Clase>

@{
    Layout = null;
    ViewData["Title"] = "Listado de Clases";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Gimnasio Cuerpo Sano</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="container mt-4">
        <h1>@ViewData["Title"]</h1>

        <div class="mb-3 text-end">
            <a asp-action="Create" class="btn btn-primary">Nueva Clase</a>
            <a asp-action="GenerarListadoPdf" target="_blank" class="btn btn-danger ms-2">Generar PDF</a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary ms-2">Volver al Inicio</a>
        </div>

        @if (!Model.Any())
        {
            <div class="alert alert-info">No hay clases registradas.</div>
        }
        else
        {
            <table class="table table-bordered table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>Nombre</th>
                        <th>Precio</th>
                        <th>Duración</th>
                        <th>Entrenador</th>
                        <th>Sala</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Nombre</td>
                            <td>@item.Precio.ToString("C2")</td>
                            <td>@item.DuracionMinutos min</td>
                            <td>@(item.Entrenador != null ? $"{item.Entrenador.Apellido}, {item.Entrenador.Nombre}" : "")</td>
                            <td>@(item.Sala != null ? item.Sala.Numero : "")</td>
                            <td class="text-center">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Detalles</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm mx-1">Editar</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Eliminar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</body>
</html>

