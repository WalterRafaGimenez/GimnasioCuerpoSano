@model IEnumerable<GimnasioCuerpoSano.Models.Sala>

@{
    Layout = null;
    ViewData["Title"] = "Listado de Salas";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gimnasio Cuerpo Sano</title>

    <link rel="icon" type="image/x-icon" href="~/img/favicon.ico" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" />

    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', sans-serif;
            padding: 2rem;
        }

        /* 🟢 UNIFICADO: Estilos para el Encabezado y Logo 🟢 */
        .main-header {
            text-align: center;
            margin-top: 1rem;
            margin-bottom: 2rem;
        }

            .main-header .page-title {
                color: #212529; /* Título oscuro para la consistencia */
                font-weight: 700;
                margin-top: 0.5rem;
                font-size: 2rem;
            }

        .card {
            border-radius: 12px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            background: white;
            overflow: hidden;
            padding: 1.5rem; /* Añadimos padding al card para el contenido */
        }

        table {
            border-radius: 10px;
            overflow: hidden;
            /* REVERTIDO: Eliminado border-collapse y border-spacing */
        }

        /* 🟢 CAMBIO CLAVE: Cabecera gris/blanca con letra negra 🟢 */
        thead th {
            background-color: #f1f3f5 !important;
            color: #212529 !important;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-size: 0.9rem;
            font-weight: 600;
        }

        tbody tr:hover {
            background-color: #f1f3f5;
            transition: 0.2s;
        }

        .btn {
            border-radius: 8px;
            font-weight: 500;
        }

        .table td, .table th {
            vertical-align: middle;
        }

        .top-buttons {
            text-align: center;
            margin-bottom: 1.5rem;
            margin-top: 1rem; /* Ajuste para separar del título */
        }

            .top-buttons .btn {
                margin: 0.3rem;
            }

    </style>
</head>

<body>
    <div class="container">


        <div class="main-header">
            <img src="~/img/Logo.png" alt="Logo Cuerpo Sano" style="width: 100px; height: auto;" />
            <h1 class="page-title">@ViewData["Title"]</h1>
        </div>

        <div class="card shadow-lg">

            <div class="card-body p-0">
                @* p-0 para que la tabla llegue al borde interno del card *@
                <div class="top-buttons">
                    <a asp-action="Create" class="btn btn-success">
                        <i class="bi bi-plus-circle"></i> Agregar Sala
                    </a>
                    @* 🟢 UNIFICADO: Botón PDF en azul primary/info para seguir la tendencia de listados 🟢 *@
                    <a asp-action="ListadoPDF" class="btn btn-primary" target="_blank">
                        <i class="bi bi-file-earmark-pdf"></i> Imprimir Listado PDF
                    </a>
                    <a href="/" class="btn btn-secondary">
                        <i class="bi bi-house-door"></i> Volver al Menú
                    </a>
                </div>

                <div class="table-responsive">
                    @* 🟢 REVERTIDO: Se usan table-bordered y table-striped para mantener el estilo de rejilla original 🟢 *@
                    <table class="table table-bordered table-striped align-middle text-center shadow-sm mb-0">
                        @* mb-0 para eliminar el margen inferior de la tabla *@
                        <thead>
                            <tr>
                                <th>Número</th>
                                <th>Nombre</th>
                                <th>Capacidad</th>
                                <th>Ubicación</th>
                                <th>Tipo</th>
                                <th>Disponible</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sala in Model)
                            {
                                <tr>
                                    <td>@sala.Numero</td>
                                    <td>@sala.Nombre</td>
                                    <td>@sala.CapacidadMaxima</td>
                                    <td>@sala.Ubicacion</td>
                                    <td>@sala.TipoSala</td>
                                    <td>
                                        <span class="badge @(sala.Disponible ? "bg-success" : "bg-danger")">
                                            @(sala.Disponible ? "Sí" : "No")
                                        </span>
                                    </td>

                                    <td>
                                        <a asp-action="Edit" asp-route-id="@sala.ID_Sala" class="btn btn-primary btn-sm me-1">
                                            <i class="bi bi-pencil"></i> Editar
                                        </a>

                                        <a asp-action="Details" asp-route-id="@sala.ID_Sala" class="btn btn-info btn-sm me-1">
                                            <i class="bi bi-eye"></i> Ver
                                        </a>

                                        <a asp-action="Delete" asp-route-id="@sala.ID_Sala" class="btn btn-danger btn-sm">
                                            <i class="bi bi-trash"></i> Eliminar
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>