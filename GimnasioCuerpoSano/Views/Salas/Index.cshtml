@model IEnumerable<GimnasioCuerpoSano.Models.Sala>
@{
    Layout = null;
    ViewData["Title"] = "Listado de Salas";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/lib/bootstrap-icons/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="container mt-4">
        <div class="card shadow-lg">
            <div class="card-header bg-primary text-white text-center">
                <h4>@ViewData["Title"]</h4>
            </div>
            <div class="card-body">
                <div class="mb-3 text-center">
                    <a asp-action="Create" class="btn btn-success me-2">
                        <i class="bi bi-plus-circle"></i> Nueva Sala
                    </a>
                    <a asp-action="ListadoPDF" class="btn btn-primary me-2" target="_blank">
                        <i class="bi bi-file-earmark-pdf"></i> Imprimir Listado PDF
                    </a>
                    <a href="/" class="btn btn-secondary">
                        <i class="bi bi-house-door"></i> Volver al Menú
                    </a>
                </div>

                <table class="table table-bordered table-striped align-middle text-center">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Número</th>
                            <th>Nombre</th>
                            <th>Capacidad</th>
                            <th>Ubicación</th>
                            <th>Tipo</th>
                            <th>Disponible</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sala in Model)
                        {
                            <tr>
                                <td>@sala.ID_Sala</td>
                                <td>@sala.Numero</td>
                                <td>@sala.Nombre</td>
                                <td>@sala.CapacidadMaxima</td>
                                <td>@sala.Ubicacion</td>
                                <td>@sala.TipoSala</td>
                                <td>@(sala.Disponible ? "Sí" : "No")</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@sala.ID_Sala" class="btn btn-info btn-sm me-1">
                                        <i class="bi bi-eye"></i> Ver
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@sala.ID_Sala" class="btn btn-warning btn-sm me-1">
                                        <i class="bi bi-pencil"></i> Editar
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@sala.ID_Sala" class="btn btn-danger btn-sm me-1">
                                        <i class="bi bi-trash"></i> Eliminar
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="text-center mt-3">
                    <a href="/" class="btn btn-primary">
                        <i class="bi bi-house-door"></i> Volver al Menú
                    </a>
                </div>
            </div>
        </div>
    </div>

    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

