@model GimnasioCuerpoSano.Models.Sala

@{
    Layout = null;
    ViewData["Title"] = "Detalles de la Sala";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- Ícono del navegador -->
    <link rel="icon" type="image/x-icon" href="~/img/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body {
            background-color: #f8f9fa;
            padding: 2rem;
            font-family: 'Segoe UI', sans-serif;
        }

        .card {
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            background: white;
            padding: 2rem;
            max-width: 600px;
            margin: auto;
        }

        h2 {
            color: #0d6efd;
            margin-bottom: 1.5rem;
            text-align: center;
        }

        .form-label {
            font-weight: bold;
            color: #495057;
            display: block;
            text-align: center;
        }

        .value-box {
            background-color: #f1f3f5;
            border-radius: 6px;
            padding: 0.5rem 1rem;
            margin-bottom: 1rem;
            width: 100%;
            text-align: center;
            box-sizing: border-box;
        }

        .btn {
            border-radius: 8px;
        }
    </style>
</head>
<body>

    <div class="container">
        <div class="card">
            <h2>Detalles de la Sala</h2>

            <!-- Número -->
            <div class="mb-3">
                <label class="form-label">Número</label>
                <div class="value-box">@Model.Numero</div>
            </div>

            <!-- Nombre -->
            <div class="mb-3">
                <label class="form-label">Nombre</label>
                <div class="value-box">@Model.Nombre</div>
            </div>

            <!-- Capacidad Máxima -->
            <div class="mb-3">
                <label class="form-label">Capacidad Máxima</label>
                <div class="value-box">@Model.CapacidadMaxima</div>
            </div>

            <!-- Ubicación -->
            <div class="mb-3">
                <label class="form-label">Ubicación</label>
                <div class="value-box">@Model.Ubicacion</div>
            </div>

            <!-- Tipo de Sala -->
            <div class="mb-3">
                <label class="form-label">Tipo de Sala</label>
                <div class="value-box">@Model.TipoSala</div>
            </div>

            <!-- Disponible -->
            <div class="mb-3">
                <label class="form-label">Disponible</label>
                <div class="value-box">@((Model.Disponible) ? "Sí" : "No")</div>
            </div>

            <div class="text-center mt-4">
                <a asp-action="Edit" asp-route-id="@Model.ID_Sala" class="btn btn-primary px-4">Editar</a>
                <a asp-action="Index" class="btn btn-secondary px-4 ms-2">Volver</a>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
