@model GimnasioCuerpoSano.Models.Miembro

@{
    Layout = null;
    ViewData["Title"] = "Mi Perfil";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gimnasio Cuerpo Sano</title>
    <link rel="icon" type="image/x-icon" href="~/img/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/GimnasioCuerpoSano.styles.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <style>
                body {
                        background-color: #f8f9fa;
                        font-family: 'Segoe UI', sans-serif;
                        padding: 1rem; /* Reducimos el padding general del body */

        }


        /* Estilos para el Encabezado (Unificado) */
                .main-header {
                        text-align: center;
                        margin-top: 0.5rem; /* Reducido */
                        margin-bottom: 1rem; /* Reducido */

        }

                .main-header .logo {
                        width: 100px;
                        height: auto;
                        margin-bottom: 5px;

        }

                .main-header .page-title {
                        color: #212529;
                        font-weight: 700;
                        font-size: 2rem;

        }


        /* Estilo para centrar el botón Volver */
                .top-action {
                        margin-bottom: 1rem; /* Reducido para acercar la tarjeta */

        }

                .card h2 {
                        color: #007bff !important;

        }


    </style>
</head>
<body class="bg-light">

    <div class="container mt-2">
       
        <div class="main-header">
            <img src="~/img/Logo.png" alt="Logo Cuerpo Sano" class="logo" />
            <h1 class="page-title">@ViewData["Title"]</h1>
        </div>

        @* BOTÓN REUBICADO: Entre el título principal y la tarjeta *@
        <div class="d-flex justify-content-center top-action">
            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
               Volver
            </a>
        </div>

        <div class="card shadow-lg p-4 rounded-4 mx-auto" style="max-width: 700px;">
           
           

            <dl class="row">
                <dt class="col-sm-4">DNI</dt>
                <dd class="col-sm-8">@Model.DNI</dd>

                <dt class="col-sm-4">Nombre</dt>
                <dd class="col-sm-8">@Model.Nombre</dd>

                <dt class="col-sm-4">Apellido</dt>
                <dd class="col-sm-8">@Model.Apellido</dd>

                <dt class="col-sm-4">Correo Electrónico</dt>
                <dd class="col-sm-8">@Model.Mail</dd>

                <dt class="col-sm-4">Teléfono</dt>
                <dd class="col-sm-8">@Model.Telefono</dd>

                <dt class="col-sm-4">Fecha de Alta</dt>
                <dd class="col-sm-8">@Model.FechaAlta.ToString("dd/MM/yyyy")</dd>

                <dt class="col-sm-4">Membresía</dt>
                <dd class="col-sm-8">
                    @if (Model.Membresia != null)
                    {
                        if (Model.FechaVencimiento >= DateTime.Now)
                        {
                            <b>@Model.Membresia.Nombre -Activa</b>
                        }
                        else
                        {
                            <span>@Model.Membresia.Nombre (Vencida)</span>
                        }
                    }
                    else
                    {
                        <span>Sin membresía activa</span>
                    }
                </dd>


            </dl>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>