@model GimnasioCuerpoSano.Models.HorarioClase

@{
    Layout = null;
    ViewData["Title"] = "Eliminar Horario de Clase";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Gimnasio Cuerpo Sano</title>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/lib/bootstrap-icons/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="/css/site.css" />
</head>
<body>
    <div class="container mt-4">
        <div class="card shadow-sm">
            <div class="card-header bg-danger text-white text-center">
                <h4>@ViewData["Title"]</h4>
            </div>
            <div class="card-body">
                <p class="mb-4">¿Está seguro que desea eliminar el siguiente horario de clase?</p>

                <dl class="row">
                    <dt class="col-sm-4">Clase</dt>
                    <dd class="col-sm-8">@Model.Clase?.Nombre</dd>

                    <dt class="col-sm-4">Día de la Semana</dt>
                    <dd class="col-sm-8">@Model.DiaSemana</dd>

                    <dt class="col-sm-4">Hora Inicio</dt>
                    <dd class="col-sm-8">@Model.HoraInicio.ToString(@"hh\:mm")</dd>

                    <dt class="col-sm-4">Hora Fin</dt>
                    <dd class="col-sm-8">@Model.HoraFin.ToString(@"hh\:mm")</dd>


                    <dt class="col-sm-4">Habilitado para inscripción</dt>
                    <dd class="col-sm-8">@((Model.SePuedeInscribir) ? "Sí" : "No")</dd>
                </dl>

                <form asp-action="Delete" method="post" class="text-center mt-4">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="bi bi-trash"></i> Eliminar
                    </button>
                    <a asp-action="Index" class="btn btn-secondary px-4 ms-2">
                        <i class="bi bi-x-circle"></i> Cancelar
                    </a>
                </form>
            </div>
        </div>
    </div>

    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
