@model GimnasioCuerpoSano.Models.HorarioClase
@{
    Layout = null;
    ViewData["Title"] = "Crear Horario";

    var clasesJson = ViewBag.ClasesJsonString;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gimnasio Cuerpo Sano</title>

    <link rel="icon" type="image/x-icon" href="~/img/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', sans-serif;
            padding: 2rem; /* Agregamos padding al body para mejor visualización */
        }

        /* 🟢 UNIFICADO: Estilos para el Encabezado y Logo 🟢 */
        .main-header {
            text-align: center;
            margin-top: 1rem;
            margin-bottom: 2rem;
        }

            .main-header .page-title {
                color: #212529; /* Título oscuro para la consistencia */
                font-weight: 700;
                margin-top: 0.5rem;
                font-size: 2rem;
            }


        .wide-container {
            max-width: 800px;
            margin: 0 auto; /* Centra el contenedor */
            padding: 0 15px;
        }

        .card {
            border-radius: 12px; /* Ligeramente más redondeado */
            box-shadow: 0 4px 10px rgba(0,0,0,0.1); /* Sombra más definida */
            background: white;
            overflow: hidden;
        }

        /* ❌ ELIMINADO: Fondo azul del título de la tarjeta ❌ */
        .card-header {
            text-align: center;
            background-color: transparent; /* Fondo transparente */
            color: #212529; /* Color de texto oscuro por si se usa */
            border-bottom: none; /* Eliminar borde inferior */
            padding: 15px 15px 0 15px; /* Ajustar padding */
        }

            .card-header h4 {
                font-weight: 600;
                color: #0d6efd; /* Mantener color azul del h4 si se usara */
            }

        .form-label {
            font-weight: 500;
        }

        .btn-container {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-top: 20px;
        }

        .btn {
            border-radius: 8px;
            font-weight: 500;
            padding: 8px 20px;
        }
    </style>

    <script>
        let ClasesDuracionMap = {};

        window.onload = function () {
            // Asegúrate de que clasesJson esté definido antes de parsear
            const clasesData = JSON.parse('@Html.Raw(clasesJson)');
            clasesData.forEach(clase => {
                ClasesDuracionMap[clase.Id] = clase.DuracionMinutos;
            });

            const claseSelect = document.getElementById("ClaseId");
            const horaInicioInput = document.getElementById("HoraInicio");

            // Llamar al calcularHoraFin() inicial si ya hay valores
            calcularHoraFin();

            claseSelect.addEventListener("change", calcularHoraFin);
            horaInicioInput.addEventListener("input", calcularHoraFin);
        };

        function calcularHoraFin() {
            const horaInicioInput = document.getElementById("HoraInicio");
            const claseSelect = document.getElementById("ClaseId");
            const horaFinInput = document.getElementById("HoraFin");

            const horaInicio = horaInicioInput.value;
            const claseId = claseSelect.value;

            // Asegurar que el id es un número
            const duracion = ClasesDuracionMap[parseInt(claseId)] || 0;

            if (horaInicio && duracion > 0) {
                const [hh, mm] = horaInicio.split(":").map(Number);
                let fecha = new Date();
                fecha.setHours(hh, mm, 0, 0); // Establecer horas y minutos
                fecha.setMinutes(fecha.getMinutes() + duracion); // Sumar duración

                const hhFin = fecha.getHours().toString().padStart(2, "0");
                const mmFin = fecha.getMinutes().toString().padStart(2, "0");
                horaFinInput.value = `${hhFin}:${mmFin}`;
            } else {
                horaFinInput.value = "";
            }
        }
    </script>

</head>
<body>
    @* 🟢 UNIFICADO: Logo y Título Principal (Reemplaza el card-header azul) 🟢 *@
    <div class="main-header">
        <img src="~/img/Logo.png" alt="Logo Cuerpo Sano" style="width: 100px; height: auto;" />
        <h1 class="page-title">@ViewData["Title"]</h1>
    </div>

    <div class="wide-container">
        <div class="card shadow-lg">
            @* Se eliminó el card-header para centrar el título con el logo * @
            @* <div class="card-header">
                <h4>@ViewData["Title"]</h4>
            </div> *@
            <div class="card-body">

                @* === BLOQUE DE DEPURACIÓN DE ERRORES === *@
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger">
                        <strong>Se encontraron errores en el formulario:</strong>
                        <ul>
                            @foreach (var key in ViewData.ModelState.Keys)
                            {
                                var state = ViewData.ModelState[key];
                                if (state.Errors.Count > 0)
                                {
                                    <li><strong>@key:</strong> @string.Join(", ", state.Errors.Select(e => e.ErrorMessage))</li>
                                }
                            }
                        </ul>
                    </div>
                }

                <form asp-action="Create" method="post" id="formHorario">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    @* === HIDDEN INPUTS PARA DEBUG Y BINDING CORRECTO (mantenerlos) === *@
                    @* Nota: Estos son necesarios para asegurar que los valores de los select se envíen correctamente al modelo si no se usan helpers directamente. Se recomienda mantenerlos si son la forma actual de trabajo. *@
                    <input type="hidden" id="ClaseIdHidden" name="ClaseId" />
                    <input type="hidden" id="SalaIdHidden" name="SalaId" />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="ClaseId" class="form-label">Clase</label>
                            <select asp-for="ClaseId" class="form-select" id="ClaseId" asp-items="ViewBag.Clases">
                                <option value="">-- Seleccione Clase --</option>
                            </select>
                            <span asp-validation-for="ClaseId" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="SalaId" class="form-label">Sala</label>
                            <select asp-for="SalaId" class="form-select" id="SalaId" asp-items="ViewBag.Salas">
                                <option value="">-- Seleccione Sala --</option>
                            </select>
                            <span asp-validation-for="SalaId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="DiaSemana" class="form-label">Día de la Semana</label>
                            <select asp-for="DiaSemana" class="form-select" asp-items="ViewBag.DiasSemana">
                                <option value="">-- Seleccione Día --</option>
                            </select>
                            <span asp-validation-for="DiaSemana" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="CapacidadMaxima" class="form-label">Capacidad Máxima (Clase)</label>
                            <input asp-for="CapacidadMaxima" type="number" min="1" class="form-control" />
                            <span asp-validation-for="CapacidadMaxima" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="HoraInicio" class="form-label">Hora Inicio</label>
                            <input asp-for="HoraInicio" type="time" class="form-control" id="HoraInicio" />
                            <span asp-validation-for="HoraInicio" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="HoraFin" class="form-label">Hora Fin (calculada)</label>
                            <input asp-for="HoraFin" type="time" class="form-control" id="HoraFin" readonly />
                            <span asp-validation-for="HoraFin" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="SePuedeInscribir" class="form-check-input" type="checkbox" />
                        <label asp-for="SePuedeInscribir" class="form-check-label">Se Puede Inscribir</label>
                    </div>

                    <div class="btn-container">
                        @* 🟢 Botón Guardar: Cambiado a btn-success (verde) para consistencia 🟢 *@
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-check-circle"></i> Guardar
                        </button>
                        @* 🟢 Botón Cancelar: Cambiado a btn-secondary (gris) 🟢 *@
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-x-circle"></i> Cancelar
                        </a>
                    </div>
                </form>

                <script>
                    const form = document.getElementById('formHorario');
                    form.addEventListener('submit', function () {
                        const claseSelect = document.getElementById('ClaseId');
                        const salaSelect = document.getElementById('SalaId');

                        // Copiar valores a los hidden inputs antes del submit
                        document.getElementById('ClaseIdHidden').value = claseSelect.value;
                        document.getElementById('SalaIdHidden').value = salaSelect.value;

                        // Los logs de consola se eliminan en producción
                        // console.log("Valor Clase enviado:", claseSelect.value);
                        // console.log("Valor Sala enviado:", salaSelect.value);
                    });
                </script>

            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>