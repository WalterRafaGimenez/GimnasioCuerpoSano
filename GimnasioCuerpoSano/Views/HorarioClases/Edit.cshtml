@model GimnasioCuerpoSano.Models.HorarioClase

@{
    Layout = null;
    ViewData["Title"] = "Editar Horario de Clase";

    // Si ClasesJsonString es null, esto podría fallar. Se usa el operador null-coalescing '??'
    var clasesJson = (string)ViewBag.ClasesJsonString ?? "[]";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gimnasio Cuerpo Sano</title>

    <link rel="icon" type="image/x-icon" href="~/img/favicon.ico" />
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/lib/bootstrap-icons/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />

    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', sans-serif;
            padding: 2rem;
        }

        /* 🟢 UNIFICADO: Estilos para el Encabezado y Logo 🟢 */
        .main-header {
            text-align: center;
            margin-top: 1rem;
            margin-bottom: 2rem;
        }

            .main-header .page-title {
                color: #212529; /* Título oscuro para la consistencia */
                font-weight: 700;
                margin-top: 0.5rem;
                font-size: 2rem;
            }

        /* 🟢 UNIFICADO: Contenedor más estrecho y centrado 🟢 */
        .wide-container {
            max-width: 800px; /* Ancho ajustado para que no se vea tan grande */
            margin: 0 auto; /* Centra el contenedor */
            padding: 0 15px;
        }

        .card {
            border-radius: 12px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            background: white;
            overflow: hidden;
        }

        .card-header {
            /* Hacer transparente para usar el título simple superior */
            background-color: transparent;
            border-bottom: none;
            padding-bottom: 0;
        }

        .form-label {
            font-weight: 500;
        }

        .btn-container {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-top: 20px;
        }

        .btn {
            border-radius: 8px;
            font-weight: 500;
            padding: 8px 20px;
        }
    </style>

    <script>
        let ClasesDuracionMap = {};

        window.onload = function() {
            // Aseguramos que el string JSON esté correctamente sanitizado para JS
            const clasesData = JSON.parse('@Html.Raw(clasesJson)');

            clasesData.forEach(clase => {
                ClasesDuracionMap[clase.Id] = clase.DuracionMinutos;
            });

            // Refs
            const claseSelect = document.getElementById("ClaseId");
            const horaInicioInput = document.getElementById("HoraInicio");

            // Calcular HoraFin al cargar (usa el valor inicial del modelo)
            calcularHoraFin();

            // Recalcular HoraFin al cambiar Clase o HoraInicio
            claseSelect.addEventListener("change", calcularHoraFin);
            horaInicioInput.addEventListener("input", calcularHoraFin);
        };

        function calcularHoraFin() {
            const horaInicioInput = document.getElementById("HoraInicio");
            const claseSelect = document.getElementById("ClaseId");
            const horaFinInput = document.getElementById("HoraFin");

            const horaInicio = horaInicioInput.value;
            const claseId = claseSelect.value;
            const duracion = ClasesDuracionMap[claseId] || 0;

            if (horaInicio && duracion > 0) {
                const [hh, mm] = horaInicio.split(":").map(Number);
                let fecha = new Date();
                fecha.setHours(hh, mm, 0, 0);
                fecha.setMinutes(fecha.getMinutes() + duracion);

                const hhFin = fecha.getHours().toString().padStart(2, "0");
                const mmFin = fecha.getMinutes().toString().padStart(2, "0");
                horaFinInput.value = `${hhFin}:${mmFin}`;
            } else {
                horaFinInput.value = '';
            }
        }
    </script>
</head>
<body>
    @* 🟢 LOGO Y TITULO PRINCIPAL 🟢 *@
    <div class="main-header">
        <img src="~/img/Logo.png" alt="Logo Cuerpo Sano" style="width: 100px; height: auto;" />
        <h1 class="page-title">@ViewData["Title"]</h1>
    </div>

    <div class="wide-container">
        <div class="card shadow-lg">
            @* Se eliminó el card-header para usar el título superior * @
            @* <div class="card-header">
                <h4>@ViewData["Title"]</h4>
            </div> *@
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="ClaseId" class="form-label">Clase</label>
                            <select asp-for="ClaseId" class="form-select" asp-items="ViewBag.Clases" id="ClaseId">
                                <option value="">-- Seleccione Clase --</option>
                            </select>
                            <span asp-validation-for="ClaseId" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="SalaId" class="form-label">Sala</label>
                            <select asp-for="SalaId" class="form-select" asp-items="ViewBag.Salas">
                                <option value="">-- Seleccione Sala --</option>
                            </select>
                            <span asp-validation-for="SalaId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="DiaSemana" class="form-label">Día de la Semana</label>
                            <select asp-for="DiaSemana" class="form-select" asp-items="ViewBag.DiasSemana">
                                <option value="">-- Seleccione Día --</option>
                            </select>
                            <span asp-validation-for="DiaSemana" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="CapacidadMaxima" class="form-label">Capacidad Máxima (Clase)</label>
                            <input asp-for="CapacidadMaxima" type="number" min="1" class="form-control" />
                            <span asp-validation-for="CapacidadMaxima" class="text-danger"></span>
                        </div>
                    </div>


                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="HoraInicio" class="form-label">Hora Inicio</label>
                            <input asp-for="HoraInicio" type="time" class="form-control" id="HoraInicio" />
                            <span asp-validation-for="HoraInicio" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="HoraFin" class="form-label">Hora Fin (calculada)</label>
                            <input asp-for="HoraFin" type="time" class="form-control" id="HoraFin" readonly />
                            <span asp-validation-for="HoraFin" class="text-danger"></span>
                        </div>
                    </div>


                    <div class="form-check mb-3">
                        <input asp-for="SePuedeInscribir" class="form-check-input" type="checkbox" />
                        <label asp-for="SePuedeInscribir" class="form-check-label">Se Puede Inscribir</label>
                    </div>

                    <div class="btn-container">
                        @* Botón Guardar Cambios (Azul) *@
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle"></i> Guardar Cambios
                        </button>
                        @* Botón Cancelar (Gris) *@
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-x-circle"></i> Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="/lib/jquery/dist/jquery.min.js"></script>

    <partial name="_ValidationScriptsPartial" />

    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>