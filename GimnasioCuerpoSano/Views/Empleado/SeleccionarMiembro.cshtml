@model List<GimnasioCuerpoSano.Models.Miembro>

@{
    Layout = null;
    ViewData["Title"] = "Seleccionar Miembro";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/x-icon" href="~/img/favicon.ico" />
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/lib/bootstrap-icons/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />
    <style>
                body {
                        background-color: #f8f9fa;
                        font-family: 'Segoe UI', sans-serif;
                        padding: 2rem;

        }

        /* Estilos para el Encabezado (Unificado) */
        .main-header {
            text-align: center;
            margin-top: 1rem;
            margin-bottom: 2rem;
        }

            .main-header .logo {
                width: 100px;
                height: auto;
                margin-bottom: 5px;
            }

            .main-header .page-title {
                color: #212529;
                font-weight: 700;
                font-size: 2rem;
            }

        /* La tarjeta ahora tiene el ancho y se centra en el body */
                .card {
                        **max-width: 400px;
            ** /* ANCHO AJUSTADO Y COMPACTO APLICADO A LA TARJETA */
            **margin: 0 auto;
            ** /* CENTRADO EN LA PÁGINA */
                        border-radius: 12px;
                        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
                        background: white;
                        padding: 20px;

        }

        .form-label {
            font-weight: 600;
        }


    </style>
</head>
<body>

    <div class="main-header">
        <img src="~/img/Logo.png" alt="Logo Cuerpo Sano" class="logo" />
        <h1 class="page-title">@ViewData["Title"]</h1>
    </div>

    <div class="container">
       
        <div class="card shadow-lg">
           
            <div class="card-body">
                <form asp-action="VerClases" method="get">
                    <div class="mb-4">
                        <label for="miembroSelect" class="form-label">Miembro:</label>
                        <select id="miembroSelect" name="miembroId" class="form-select" required>
                            <option value="">-- Seleccione un miembro --</option>
                            @foreach (var m in Model)
                            {
                                <option value="@m.Id">@m.Nombre @m.Apellido</option>
                            }
                        </select>
                    </div>

                    <div class="text-center mt-5 d-flex justify-content-center gap-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-calendar-check"></i> Ver Clases
                        </button>

                        <a asp-action="ImprimirInscripciones" target="_blank" class="btn btn-success">
                            <i class="bi bi-file-earmark-pdf"></i> Lista de clases inscriptas PDF
                        </a>

                        <a href="/" class="btn btn-secondary">
                            <i class="bi bi-x-circle"></i> Volver al Menú
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>