@model GimnasioCuerpoSano.Models.ViewModels.ClasesEmpleadoViewModel

@{
    Layout = null; // Aseguramos que no se use un layout que pueda interferir con el estilo
    ViewData["Title"] = "Clases Disponibles";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/x-icon" href="~/img/favicon.ico" />
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/lib/bootstrap-icons/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />
    <style>
                                body {
                                                background-color: #f8f9fa;
                                                font-family: 'Segoe UI', sans-serif;
                                                padding: 2rem;

        }



        /* 🟢 Estilos para el Encabezado (Unificado) 🟢 */
                        .main-header {
                                    text-align: center;
                                    margin-top: 1rem;
                                    margin-bottom: 2rem;

        }

                            .main-header .logo {
                                        width: 100px;
                                        height: auto;
                                        margin-bottom: 5px;

        }

                            .main-header .page-title {
                                        color: #212529; /* Título oscuro para la consistencia */
                                        font-weight: 700;
                                        font-size: 2rem;

        }

                                .wide-container {
                                                max-width: 1000px; /* Ancho ajustado para la tabla */
                                                margin: 0 auto; /* Centrar */
                                                padding: 0 15px;

        }

                                .card {
                                                border-radius: 12px;
                                                box-shadow: 0 4px 10px rgba(0,0,0,0.1);
                                                background: white;
                                                padding: 20px;

        }

                                .table-light th {
                                                **background-color: #e9ecef !important;
                        ** /* Cabecera gris clara */
                                                **color: #212529 !important;
                        ** /* Letras oscuras */
                                                vertical-align: middle;
                        **font-weight: 700;
                        **                 
        }

                                .table td.actions {
                                                white-space: nowrap;

        }

        
        .global-actions {
            margin: 1.5rem auto; /* Espacio y centrado */
            text-align: center;
        }



    </style>
</head>
<body>

   
    <div class="main-header">
        <img src="~/img/Logo.png" alt="Logo Cuerpo Sano" class="logo" />
        <h1 class="page-title">Clases Disponibles para @Model.NombreCompletoMiembro</h1>
    </div>

   
    <div class="wide-container">
        <div class="global-actions">
            <a asp-action="SeleccionarMiembro" class="btn btn-secondary px-4">
                <i class="bi bi-arrow-left"></i> Volver
            </a>
        </div>
    </div>


    <div class="wide-container">
        <div class="card shadow-lg">
            <div class="card-body">


                <div class="table-responsive">
                    <table class="table table-bordered table-striped align-middle text-center">
                        <thead class="table-light">
                            <tr>
                                <th>Clase</th>
                                <th>Entrenador</th>
                                <th>Hora Inicio</th>
                                <th>Hora Fin</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var h in Model.ClasesDisponibles)
                            {
                                var yaInscripto = h.Inscripciones?.Any(i => i.MiembroId == Model.MiembroId) ?? false;
                                <tr>
                                    <td>@(h.Clase?.Nombre ?? "Sin clase")</td>
                                    <td>@(h.Clase?.Entrenador != null ? h.Clase.Entrenador.Nombre + " " + h.Clase.Entrenador.Apellido : "Sin entrenador")</td>
                                    <td>@h.HoraInicio.ToString(@"hh\:mm")</td>
                                    <td>@h.HoraFin.ToString(@"hh\:mm")</td>
                                    <td>
                                        @if (yaInscripto)
                                        {
                                            <span class="badge bg-success">Inscripto</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info text-dark">Disponible</span>
                                        }
                                    </td>
                                    <td class="actions">
                                        @if (!yaInscripto)
                                        {
                                            <form asp-action="Inscribirse" method="post" style="display:inline">
                                                <input type="hidden" name="miembroId" value="@Model.MiembroId" />
                                                <input type="hidden" name="horarioClaseId" value="@h.Id" />
                                                <button type="submit" class="btn btn-success btn-sm">
                                                    <i class="bi bi-person-plus"></i> Inscribirse
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="Desinscribirse" method="post" style="display:inline">
                                                <input type="hidden" name="miembroId" value="@Model.MiembroId" />
                                                <input type="hidden" name="horarioClaseId" value="@h.Id" />
                                                <button type="submit" class="btn btn-danger btn-sm">
                                                    <i class="bi bi-person-dash"></i> Desinscribirse
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

       
    </div>
    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>