@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Gimnasio Cuerpo Sano</title>
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="container">
        <h1>🏋️ Gimnasio Cuerpo Sano</h1>

        @if (User?.Identity?.IsAuthenticated ?? false)
        {
            <p style="text-align:center;">Bienvenido, <strong>@User.Identity?.Name</strong></p>

            @if (User.IsInRole("Administrador") || User.IsInRole("Empleado"))
            {
                <div class="text-center mt-4">
                    <a asp-controller="Miembros" asp-action="Index" class="btn btn-primary">📋 Miembros</a>
                    <a asp-controller="Membresias" asp-action="Index" class="btn btn-success">💳 Membresías</a>
                </div>
            }

            <div class="text-center mt-4">
                <form asp-area="Identity" asp-page="/Account/Logout" method="post">
                    <button type="submit" class="btn btn-danger">🚪 Cerrar sesión</button>
                </form>
            </div>
        }
        else
        {
            <div class="text-center mt-4">
                <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary">Iniciar sesión</a>
                <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-secondary">Registrarse</a>
            </div>
        }
    </div>
</body>
</html>



