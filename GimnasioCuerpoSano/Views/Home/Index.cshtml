@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Gimnasio Cuerpo Sano</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body style="font-family:Arial; text-align:center; margin-top:50px;">
    <h1>🏋️ Gimnasio Cuerpo Sano</h1>

    @if (User.Identity.IsAuthenticated)
    {
        <p>Bienvenido, <strong>@User.Identity.Name</strong></p>

        @if (User.IsInRole("Administrador") || User.IsInRole("Empleado"))
        {
            <div style="margin:20px;">
                <a asp-controller="Miembros" asp-action="Index" class="btn btn-outline-primary mx-2">Miembros</a>
                <a asp-controller="Membresias" asp-action="Index" class="btn btn-outline-success mx-2">Membresías</a>
            </div>
        }

        <form asp-area="Identity" asp-page="/Account/Logout" method="post">
            <button type="submit" class="btn btn-outline-danger mt-3">Cerrar sesión</button>
        </form>
    }
    else
    {
        <div style="margin:20px;">
            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-primary mx-2">Iniciar sesión</a>
            <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-outline-secondary mx-2">Registrarse</a>
        </div>
    }
</body>
</html>


