@{
    Layout = null; // sin layout
    ViewData["Title"] = "Inicio - Gimnasio Cuerpo Sano";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body {
            background: linear-gradient(135deg, #0d6efd, #198754);
            min-height: 100vh;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', sans-serif;
        }

        .menu-card {
            background: white;
            color: #212529;
            border-radius: 12px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
            padding: 2rem;
            max-width: 600px;
            text-align: center;
        }

        h1 {
            color: #0d6efd;
            margin-bottom: 1.5rem;
        }

        .btn {
            border-radius: 10px;
            width: 200px;
            margin: 0.5rem;
        }

        footer {
            position: fixed;
            bottom: 10px;
            width: 100%;
            text-align: center;
            color: rgba(255,255,255,0.7);
        }
    </style>
</head>
<body>
    <div class="menu-card">
        <h1>Gimnasio Cuerpo Sano</h1>
        <p class="mb-4">Bienvenido al sistema de gestión del gimnasio</p>

        <div>
            <a asp-controller="Miembros" asp-action="Create" class="btn btn-success">Alta de miembro</a>
            <a asp-controller="Miembros" asp-action="Index" class="btn btn-primary">Listado de miembros</a>
          
        </div>
    </div>

    <footer>
        &copy; @DateTime.Now.Year - Gimnasio Cuerpo Sano
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

