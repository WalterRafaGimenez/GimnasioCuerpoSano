@model IEnumerable<GimnasioCuerpoSano.Models.ViewModels.ClaseDisponibleViewModel>

@{
    Layout = null;
    ViewData["Title"] = "Clases Disponibles";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/x-icon" href="~/img/favicon.ico" />
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/lib/bootstrap-icons/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />
    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', sans-serif;
            padding: 2rem;
        }

        .main-header {
            text-align: center;
            margin-top: 1rem;
            margin-bottom: 2rem;
        }

            .main-header .logo {
                width: 100px;
                height: auto;
                margin-bottom: 5px;
            }

            .main-header .page-title {
                color: #212529;
                font-weight: 700;
                font-size: 2rem;
            }

        .container {
            max-width: 900px;
        }

        .btn-volver {
            margin-bottom: 1.5rem;
        }
    </style>
</head>
<body class="bg-light">

    <div class="container mt-4">

        <div class="main-header">
            <img src="~/img/Logo.png" alt="Logo Cuerpo Sano" class="logo" />
            <h1 class="page-title">@ViewData["Title"]</h1>
        </div>

        @* Mensajes de TempData *@
        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Mensaje"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="d-flex justify-content-center btn-volver">
            <a href="/" class="btn btn-secondary">
                <i class="bi bi-arrow-left-circle"></i> Volver
            </a>
        </div>

        <div class="card shadow-lg p-3 rounded-4">
            <div class="table-responsive">
                <table class="table table-bordered table-striped text-center align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Clase / Sala</th>
                            <th>Día</th>
                            <th>Horario</th>
                            <th>Duración (min)</th>
                            <th>Precio</th>
                            <th>Entrenador</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td><strong>@item.NombreClase</strong> / @item.SalaNombre</td>
                                    <td>@item.DiaSemana</td>
                                    <td>@item.HoraInicio.ToString(@"hh\:mm")</td>
                                    <td>@item.DuracionMinutos</td>
                                    <td>@item.Precio.ToString()</td>
                                    <td>@item.EntrenadorNombre</td>
                                    <td>
                                        @if (item.EstaInscripto)
                                        {
                                            <a asp-controller="Inscripciones" asp-action="Desinscribirse"
                                               asp-route-horarioClaseId="@item.HorarioClaseId"
                                               class="btn btn-danger btn-sm">
                                                <i class="bi bi-x-circle"></i> Desinscribirse
                                            </a>
                                        }
                                        else if (item.EstaLleno)
                                        {
                                            <span class="badge bg-warning text-dark">No hay cupos disponibles</span>
                                        }
                                        else
                                        {
                                            <a asp-controller="Inscripciones" asp-action="Inscribirse"
                                               asp-route-horarioClaseId="@item.HorarioClaseId"
                                               class="btn btn-success btn-sm">
                                                <i class="bi bi-check-circle"></i> Inscribirse
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-muted text-center py-3">
                                    No hay clases disponibles por el momento.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
</html>