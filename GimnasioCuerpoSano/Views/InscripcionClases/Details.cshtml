@model GimnasioCuerpoSano.Models.InscripcionClaseViewModel

@{
    Layout = null;
    ViewData["Title"] = "Detalle de Inscripción a Clase";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/lib/bootstrap-icons/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="wide-container">
        <div class="card shadow-lg">
            <div class="card-header text-center bg-primary text-white">
                <div class="logo-container mb-2">
                    <img src="~/img/Logo.png" alt="Logo Gimnasio" style="height: 80px;" />
                </div>
                <h4>@ViewData["Title"]</h4>
            </div>

            <div class="card-body">
                <table class="table table-bordered align-middle">
                    <tr>
                        <th>Miembro</th>
                        <td>@Model.NombreMiembro</td>
                    </tr>
                    <tr>
                        <th>DNI</th>
                        <td>@Model.DNI</td>
                    </tr>
                    <tr>
                        <th>Clase</th>
                        <td>@Model.NombreClase</td>
                    </tr>
                    <tr>
                        <th>Entrenador</th>
                        <td>@Model.NombreEntrenador</td>
                    </tr>
                    <tr>
                        <th>Día</th>
                        <td>@Model.DiaSemana</td>
                    </tr>
                    <tr>
                        <th>Hora Inicio</th>
                        <td>@Model.HoraInicio</td>
                    </tr>
                    <tr>
                        <th>Hora Fin</th>
                        <td>@Model.HoraFin</td>
                    </tr>
                    <tr>
                        <th>Estado</th>
                        <td>
                            @if (Model.Estado == "Inscripto")
                            {
                                <span class="badge bg-success">Inscripto</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">No Inscripto</span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <th>Fecha de Inscripción</th>
                        <td>@Model.FechaInscripcion.ToString("dd/MM/yyyy")</td>
                    </tr>
                </table>

                <a asp-action="Index" asp-route-dni="@Model.DNI" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Volver
                </a>
            </div>
        </div>
    </div>

    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

