@model IEnumerable<GimnasioCuerpoSano.Models.InscripcionClaseViewModel>

@{
    Layout = null;
    ViewData["Title"] = "Listado de Clases Disponibles";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/lib/bootstrap-icons/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="container mt-4">
        <h2 class="text-center">@ViewData["Title"]</h2>
        <h5 class="text-center">@ViewBag.Miembro?.Nombre @ViewBag.Miembro?.Apellido</h5>

        <form asp-action="Index" method="get" class="d-flex justify-content-center mb-3">
            <input type="text" name="dni" class="form-control" placeholder="Ingrese DNI" required
                   value="@(ViewContext.HttpContext.Request.Query["dni"])" style="max-width: 180px;" />
            <button type="submit" class="btn btn-primary ms-2">Buscar clases disponibles</button>
        </form>
        <div class="d-flex justify-content-center mb-3">
            <a href="/" class="btn btn-secondary">
                <i class="bi bi-house-door"></i> Volver al Menú
            </a>
        </div>

        @if (ViewBag.MembresiaValida == false)
        {
            <div class="alert alert-danger text-center">
                Tu membresía no está activa. No puedes inscribirte a clases.
            </div>
        }

        <div class="table-responsive">
            <table class="table table-bordered table-striped text-center">
                <thead class="table-light">
                    <tr>
                        <th>Clase</th>
                        <th>Entrenador</th>
                        <th>Hora Inicio</th>
                        <th>Hora Fin</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var clase in Model)
                        {
                            <tr>
                                <td>@clase.NombreClase</td>
                                <td>@clase.NombreEntrenador</td>
                                <td>@clase.HoraInicio</td>
                                <td>@clase.HoraFin</td>
                                <td>
                                    <span class="badge @(clase.Estado == "Inscripto" ? "bg-success" : "bg-secondary")">
                                        @clase.Estado
                                    </span>
                                </td>
                                <td>
                                    <a asp-action="Inscribirse"
                                       asp-route-id="@clase.Id"
                                       asp-route-dni="@(ViewContext.HttpContext.Request.Query["dni"])"
                                       class="btn btn-success btn-sm me-1">
                                        <i class="bi bi-check-circle"></i> Inscribirse
                                    </a>
                                    <a asp-action="Desinscribirse"
                                       asp-route-id="@clase.Id"
                                       asp-route-dni="@(ViewContext.HttpContext.Request.Query["dni"])"
                                       class="btn btn-warning btn-sm me-1">
                                        <i class="bi bi-x-circle"></i> Desinscribirse
                                    </a>
                                    @if (clase.Estado == "Inscripto")
                                    {
                                        <a asp-action="Details"
                                           asp-route-id="@clase.InscripcionId"
                                           asp-route-dni="@(ViewContext.HttpContext.Request.Query["dni"])"
                                           class="btn btn-info btn-sm">Ver</a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-muted text-center">
                                No hay clases disponibles por el momento.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

