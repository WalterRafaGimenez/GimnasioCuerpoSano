@model GimnasioCuerpoSano.Models.InscripcionClase

@{
    Layout = null;
    ViewData["Title"] = "Crear Inscripción";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/lib/bootstrap-icons/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />

    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', sans-serif;
        }

        .wide-container {
            max-width: 800px;
            margin: 30px auto;
            padding: 15px;
        }

        .card {
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        .card-header {
            text-align: center;
            background-color: #0d6efd;
            color: white;
            border-radius: 10px 10px 0 0;
            padding: 15px;
        }

        .logo-container img {
            height: 80px;
            margin-bottom: 10px;
        }

        .form-label {
            font-weight: bold;
        }

        .btn-actions {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-top: 20px;
        }
    </style>
</head>
<body>
    <div class="wide-container">
        <div class="card shadow-lg">
            <div class="card-header">
                <div class="logo-container">
                    <img src="~/img/Logo.png" alt="Logo Gimnasio" />
                </div>
                <h4>@ViewData["Title"]</h4>
            </div>

            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div class="mb-3">
                        <label asp-for="MiembroId" class="form-label">Miembro</label>
                        <select asp-for="MiembroId" asp-items="@(new SelectList(ViewBag.Miembros, "Id", "NombreApellido"))" class="form-select"></select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="HorarioClaseId" class="form-label">Clase</label>
                        <select asp-for="HorarioClaseId" asp-items="@(new SelectList(ViewBag.Horarios, "Id", "ClaseNombre"))" class="form-select"></select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Estado" class="form-label">Estado</label>
                        <select asp-for="Estado" class="form-select">
                            <option value="true">Inscripto</option>
                            <option value="false">No Inscripto</option>
                        </select>
                    </div>

                    <div class="btn-actions">
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-check-circle"></i> Guardar
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left-circle"></i> Volver
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

