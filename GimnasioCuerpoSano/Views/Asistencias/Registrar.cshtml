@model IEnumerable<GimnasioCuerpoSano.Models.Miembro>

@{
    Layout = null;
    ViewData["Title"] = "Registrar Asistencia";
    // El ViewBag.AsistenciasHoy se maneja dentro del foreach, por lo que no es necesario aquí.
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/x-icon" href="~/img/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />

    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', sans-serif;
            padding: 2rem;
        }

        .form-container {
            max-width: 1100px;
            margin: 0 auto;
            background: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        /* Estilo para el logo (tomado del dashboard) */
        .header-logo {
            display: block;
            margin: 0 auto 15px auto;
            max-width: 120px;
            height: auto;
        }

        h2 {
            color: #0d6efd;
            text-align: center;
            margin-bottom: 2rem;
        }

        th {
            background-color: #0d6efd; /* Color principal de la marca (Azul) */
            color: white;
            text-align: center;
        }

        td {
            text-align: center;
            vertical-align: middle;
        }

        .btn {
            border-radius: 8px;
            font-weight: 500;
        }

        .alert {
            text-align: center;
        }

        .table-container {
            margin-top: 1rem;
        }
    </style>
</head>
<body>
    <div class="form-container">

        @* INTEGRACIÓN DEL LOGO *@
        <img src="/img/Logo.png" alt="Logo Gimnasio Cuerpo Sano" class="header-logo" />

        <h2>@ViewData["Title"]</h2>

        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-success">@TempData["Mensaje"]</div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-warning">@TempData["Error"]</div>
        }

        @* BOTONES SUPERIORES: Coherencia de Color *@
        <div class="d-flex justify-content-center gap-2 mb-3">
            @* 'Ver Asistencias' es una acción principal para este módulo, lo dejaremos en Azul (o Gris, si se considera secundario). 
               Lo mantendremos en Gris, como acción de navegación. *@
            <a asp-controller="Asistencias" asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-list-columns"></i> Ver Asistencias
            </a>

            @* 'Volver al Menú' es neutral. Se cambia de 'btn-outline-secondary' a 'btn-secondary' para que sea sólido. *@
            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Volver al Menú
            </a>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive table-container">
                <table class="table table-striped table-bordered align-middle text-center">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Apellido</th>
                            <th>DNI</th>
                            <th>Vencimiento</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var miembro in Model)
                        {
                            <tr>
                                <td>@miembro.Nombre</td>
                                <td>@miembro.Apellido</td>
                                <td>@miembro.DNI</td>
                                <td>@miembro.FechaVencimiento.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @{
                                        // Usamos el código de búsqueda que ya tienes
                                        var asistenciasHoy = ViewBag.AsistenciasHoy as List<GimnasioCuerpoSano.Models.Asistencia>;
                                        var asistencia = asistenciasHoy?.FirstOrDefault(a => a.ID_Miembro == miembro.Id);
                                    }

                                    @if (asistencia != null)
                                    {
                                        if (asistencia.HoraSalida == null)
                                        {
                                            <span class="text-success fw-bold me-2">✅ Ingreso OK</span>
                                            <form asp-action="RegistrarSalida" method="post" style="display:inline;">
                                                <input type="hidden" name="id" value="@miembro.Id" />
                                                @* Botón de Salida: Rojo (Advertencia/Fin de acción) *@
                                                <button type="submit" class="btn btn-danger btn-sm">Salida</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-secondary fw-bold">🏁 Salida registrada</span>
                                        }
                                    }
                                    else
                                    {
                                        <form asp-action="RegistrarEntrada" method="post" style="display:inline;">
                                            <input type="hidden" name="id" value="@miembro.Id" />
                                            @* Botón de Entrada: Verde (Acción de éxito/Creación de registro) *@
                                            <button type="submit" class="btn btn-success btn-sm">Entrada</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info mt-3">No hay miembros activos para registrar asistencia.</div>
        }
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>