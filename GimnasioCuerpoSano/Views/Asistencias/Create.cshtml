@model GimnasioCuerpoSano.Models.Asistencia

@{
    Layout = null;
    ViewData["Title"] = "Registrar Asistencia";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/x-icon" href="~/img/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />

    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', sans-serif;
            padding: 2rem;
        }

        .form-container {
            max-width: 700px;
            margin: 0 auto;
            background: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        h2 {
            color: #0d6efd;
            text-align: center;
            margin-bottom: 2rem;
        }

        .btn {
            border-radius: 8px;
        }

        .card {
            background: #fff;
            border-radius: 10px;
            box-shadow: 0 1px 4px rgba(0,0,0,0.1);
            padding: 15px;
            margin-bottom: 15px;
        }

        .alert {
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="form-container">

        <h2>Registrar Asistencia</h2>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-warning">@TempData["Error"]</div>
        }
        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-success">@TempData["Mensaje"]</div>
        }

        <!-- Formulario para buscar miembro -->
        <form asp-action="Create" method="post" class="mb-3">
            <div class="mb-3">
                <label for="dni" class="form-label">DNI del Miembro:</label>
                <input type="text" name="dni" id="dni" class="form-control" value="@ViewBag.Miembro?.DNI" required />
            </div>

            <div class="d-flex justify-content-center gap-2 mb-3">
                <button type="submit" class="btn btn-primary">Buscar</button>
                <a asp-controller="Asistencias" asp-action="Index" class="btn btn-secondary">Volver</a>
            </div>
        </form>

        <!-- Mostrar datos del miembro si existe -->
        @if (ViewBag.Miembro != null)
        {
            <div class="card">
                <p><strong>Nombre:</strong> @ViewBag.Miembro.Nombre</p>
                <p><strong>Apellido:</strong> @ViewBag.Miembro.Apellido</p>
                <p><strong>Hora Actual:</strong> @ViewBag.HoraActual</p>
                <p><strong>Estado Membresía:</strong> @ViewBag.EstadoMembresia</p>

                @if ((bool)ViewBag.YaAsistioHoy)
                {
                    <div class="alert alert-warning mt-2">Ya registró asistencia hoy.</div>
                }
                else if (ViewBag.EstadoMembresia == "Inactiva")
                {
                    <div class="alert alert-danger mt-2">La membresía no está activa.</div>
                }
                else
                {
                    <form asp-action="Create" method="post" class="text-center mt-3">
                        <input type="hidden" name="dni" value="@ViewBag.Miembro.DNI" />
                        <input type="hidden" name="registrar" value="true" />
                        <button type="submit" class="btn btn-success btn-lg">
                            Registrar Asistencia
                        </button>
                    </form>
                }
            </div>
        }
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

