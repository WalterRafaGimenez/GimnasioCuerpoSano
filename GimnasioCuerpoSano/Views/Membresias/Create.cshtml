@model GimnasioCuerpoSano.Models.Membresia

@{
    Layout = null;
    ViewData["Title"] = "Crear Membresía"; 
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/x-icon" href="~/img/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />
    <style>
        body {
            background-color: #f8f9fa;
            padding: 2rem;
            font-family: 'Segoe UI', sans-serif;
        }

        .form-container {
            max-width: 600px;
            margin: 0 auto;
        }

        /* Estilo para el Logo */
        .header-logo {
            display: block;
            margin: 0 auto 15px auto; /* Centra horizontalmente y añade espacio abajo */
            max-width: 100px;
            height: auto;
        }

        .card {
            box-shadow: 0 2px 8px rgba(0,0,0,0.1); /* Sombra mejorada */
            border-radius: 10px;
            padding: 2rem; /* Añadir padding dentro de la tarjeta */
            background: white;
        }

        .btn {
            border-radius: 8px;
            /* Se quitó el 'px-4' de los botones en el HTML para que no sean tan anchos */
        }

        h2 {
            color: black; /* Cambiado a negro para estandarizar con otras vistas */
            font-weight: 600;
            margin-bottom: 1.5rem;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="form-container">
        <div class="card p-4">
            <img src="/img/Logo.png" alt="Logo Gimnasio Cuerpo Sano" class="header-logo" />

            <h2>Crear Membresía</h2>
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label"></label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Precio" class="form-label"></label>
                    <input asp-for="Precio" class="form-control" />
                    <span asp-validation-for="Precio" class="text-danger"></span>
                </div>

              
                <div class="d-flex justify-content-center mt-4">
                    @* 1. y 3. Texto cambiado a "Guardar" y se quitó la clase 'px-4' para reducir el ancho. *@
                    <input type="submit" value="Guardar" class="btn btn-success me-2" style="width: 120px;" />
                    @* 2. El `d-flex` y `justify-content-center` los pone en línea y centrados. *@
                    <a asp-action="Index" class="btn btn-secondary" style="width: 120px;">Volver</a>
                </div>
            </form>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}