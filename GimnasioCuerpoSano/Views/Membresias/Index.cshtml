@model IEnumerable<GimnasioCuerpoSano.Models.Membresia>

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Membresías - Gimnasio Cuerpo Sano</title>
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />

</head>
<body>
    <div class="container">
        <h1>Listado de Membresías</h1>

        <div class="text-center mb-3">
            <a asp-action="Create" class="btn btn-success">Nueva Membresía</a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Volver al Menú</a>
        </div>

        <table>
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Nombre)</th>
                    <th>@Html.DisplayNameFor(model => model.Precio)</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.Nombre)</td>
                        <td>$@item.Precio</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning">Editar</a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info">Ver</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Eliminar</a>

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>

