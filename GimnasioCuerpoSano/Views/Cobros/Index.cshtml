@model IEnumerable<GimnasioCuerpoSano.Models.Cobro>

@{
    Layout = null;
    ViewData["Title"] = "Listado de Cobros";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Listado de Cobros - Gimnasio Cuerpo Sano</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="container">
        <h1>Listado de Cobros</h1>

        @* Mensajes de éxito o error *@
        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-success">@TempData["Mensaje"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        <div class="mb-3">
            <a asp-action="Create" class="btn btn-success">Nuevo Cobro</a>
            <a asp-action="ListadoPDF" class="btn btn-info ms-2" target="_blank">Listado PDF</a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary ms-2">Volver al Menú</a>
        </div>

        <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Socio</th>
                    <th>Membresía</th>
                    <th>Monto</th>
                    <th>Fecha de Pago</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@c.Miembro?.Nombre @c.Miembro?.Apellido</td>
                        <td>@c.Membresia?.Nombre</td>
                        <td>@c.Monto.ToString("C")</td>
                        <td>@c.FechaPago.ToString("dd/MM/yyyy")</td>
                        <td>
                            <span class="badge @(c.Estado == "Vencido" ? "bg-danger" : "bg-success")">
                                @c.Estado
                            </span>
                        </td>
                        <td>
                            <a class="btn btn-info btn-sm" asp-action="Details" asp-route-id="@c.Id">Ver</a>
                            <a class="btn btn-primary btn-sm" asp-action="Edit" asp-route-id="@c.Id">Editar</a>
                            <a class="btn btn-danger btn-sm" asp-action="Delete" asp-route-id="@c.Id">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>

