@model GimnasioCuerpoSano.Models.Cobro
@{
    Layout = null;
    ViewData["Title"] = "Detalles del Cobro";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Gimnasio Cuerpo Sano</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="container">
        <h1>📄 Detalles del Cobro</h1>

        <div class="card p-4 mt-4 shadow-sm">
            <p><strong>Código:</strong> @Model.Codigo</p>
            <p><strong>Monto:</strong> $@Model.Monto.ToString("N2")</p>
            <p><strong>Fecha de Pago:</strong> @Model.FechaPago.ToString("dd/MM/yyyy")</p>
            <p><strong>Método de Pago:</strong> @Model.MetodoPago</p>
            <p>
                <strong>Estado:</strong>
                <span style="color:@(Model.Estado == "Vencido" ? "red" : "green")">
                    @Model.Estado
                </span>
            </p>
            <p><strong>Miembro:</strong> @Model.Miembro?.Nombre @Model.Miembro?.Apellido</p>
            <p><strong>Membresía:</strong> @Model.Membresia?.Nombre</p>

            <div class="text-center mt-4">
                <a asp-action="Index" class="btn btn-secondary">↩️ Volver</a>
                <a asp-action="GenerarReciboPdf" asp-route-id="@Model.Id" class="btn btn-success">📄 Generar PDF</a>
            </div>
        </div>
    </div>
</body>
</html>

