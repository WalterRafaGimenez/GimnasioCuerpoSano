@model IEnumerable<GimnasioCuerpoSano.Controllers.UserRolesViewModel>
@{
    Layout = null; // 1. Quitar el Layout
    ViewData["Title"] = "Gestión de Roles";
    var allRoles = ViewBag.AllRoles as List<string>;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/x-icon" href="~/img/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />

    <style>
        /* ESTILOS DEL ARCHIVO ORIGINAL */
        body {
            background-color: #f8f9fa;
            padding: 2rem;
            font-family: 'Segoe UI', sans-serif;
        }

        /* NUEVA CLASE PARA CENTRAR EL LISTADO */
        .list-container {
            max-width: 1400px; /* Ancho máximo para el contenido, puedes ajustarlo si quieres más o menos */
            margin: 0 auto; /* Centra el contenedor horizontalmente */
            padding: 0 15px; /* Pequeño padding lateral para responsividad */
        }

        .card {
            box-shadow: 0 2px 6px rgba(0,0,0,0.1);
            border-radius: 10px;
        }

        table {
            background: white;
            border-radius: 8px;
            overflow: hidden;
        }

        th {
            background-color: #0d6efd; /* Azul de Bootstrap Primary */
            color: white;
        }

        .btn {
            border-radius: 8px;
        }

        h2 {
            color: #0d6efd;
            margin-bottom: 1.5rem;
        }
    </style>
</head>
<body>

    <div class="list-container">
        <div class="text-center mb-4">
            <h2>Gestión de Roles de Usuarios</h2>

            @if (TempData["Mensaje"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Mensaje"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            }

        </div>

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive card">
                <table class="table table-striped table-bordered align-middle text-center">
                    <thead>
                        <tr>
                            <th>Email</th>
                            <th>Rol Actual</th>
                            <th>Cambiar Rol</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>@user.Email</td>
                                <td>
                                    @if (user.CurrentRole == "Sin rol")
                                    {
                                        <span class="badge bg-secondary">Sin rol asignado</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary">@user.CurrentRole</span>
                                    }
                                </td>
                                <td>
                                    <form asp-action="ChangeRole" method="post" class="d-flex justify-content-center">
                                        <input type="hidden" name="userId" value="@user.UserId" />
                                        <select name="newRole" class="form-select me-2" style="width:180px;">

                                            @* Opción predeterminada para "Sin rol" *@
                                            @if (user.CurrentRole == "Sin rol")
                                            {
                                                <option value="" selected disabled>Seleccionar rol...</option>
                                            }

                                            @* Opciones de roles con la sintaxis corregida *@
                                            @foreach (var role in allRoles)
                                            {
                                                <option value="@role"
                                                        selected="@(user.CurrentRole == role ? "selected" : null)">
                                                    @role
                                                </option>
                                            }
                                        </select>
                                        <button type="submit" class="btn btn-primary btn-sm">Guardar</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info text-center">No hay usuarios registrados para gestionar roles.</div>
        }

        <div class="text-center mt-4">
            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary px-4">Volver al Menú</a>
        </div>

    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
