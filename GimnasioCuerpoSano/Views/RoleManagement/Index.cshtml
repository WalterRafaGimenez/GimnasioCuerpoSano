@model IEnumerable<GimnasioCuerpoSano.Controllers.UserRolesViewModel>
@{
    Layout = null;
    ViewData["Title"] = "Gestión de Roles";
    var allRoles = ViewBag.AllRoles as List<string>;
}

@* 1. Función para mapear el rol a la clase de badge de Bootstrap con los colores definidos *@
@{
    string GetRoleBadgeClass(string role)
    {
        return role switch
        {
            "Administrador" => "bg-primary",
            "Entrenador" => "bg-success",
            "Empleado" => "bg-info text-dark",
            "Miembro" => "bg-secondary",
            _ => "bg-secondary", // Color por defecto para 'Sin rol'
        };
    }

    string GetRoleButtonClass(string role)
    {
        return role switch
        {
            "Administrador" => "btn-primary",
            "Entrenador" => "btn-success",
            "Empleado" => "btn-info text-dark",
            "Miembro" => "btn-secondary",
            _ => "btn-primary", // Color por defecto al inicio
        };
    }
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/x-icon" href="~/img/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />

    <style>

        /* ESTILOS DE ESTANDARIZACIÓN */
                body {
                        background-color: #f8f9fa;
                        padding: 2rem;
                        font-family: 'Segoe UI', sans-serif;

        }


        /* AJUSTE DEL ANCHO DEL CARD */
                .list-container {
                        max-width: 900px; /* Ancho ajustado para centrar y reducir */
                        margin: 0 auto;
                        padding: 0 15px;

        }

                .card {
                        box-shadow: 0 2px 6px rgba(0,0,0,0.1);
                        border-radius: 10px;

        }

                table {
                        background: white;
                        border-radius: 8px;
                        overflow: hidden;

        }

                th {
                        background-color: #0d6efd; /* Azul de Bootstrap Primary */
                        color: white;

        }

                .btn {
                        border-radius: 8px;

        }


        /* 2. Título en negro y centrado, sin afectar el margin-bottom */
                h2 {
                        color: black;
                        font-weight: 600;
                        margin-bottom: 1.5rem;

        }


        /* Estilo para que el botón de Info tenga texto oscuro, como definimos arriba */
                .btn-info.text-dark {
                        color: #212529 !important;
                        background-color: #0dcaf0;
                        border-color: #0dcaf0;

        }


    </style>
</head>
<body>

    <div class="list-container">
        <div class="card p-4">
            @* Contenedor principal con la sombra *@

            <div class="text-center mb-4">
                @* 1. AÑADIR EL LOGO *@
                <img src="~/img/logo.png" alt="Cuerpo Sano Logo" style="width: 70px; margin-bottom: 10px;" />
                <h2>Gestión Rol de Usuarios</h2>

                @if (TempData["Mensaje"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["Mensaje"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                    </div>
                }

                
                <div class="text-center mb-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary px-4">Volver al Menú</a>
                </div>
            </div>

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    
                    <table class="table table-striped table-bordered align-middle text-center">
                        <thead>
                            <tr>
                                <th>Email</th>
                                <th>Rol Actual</th>
                                <th>Cambiar Rol</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td>@user.Email</td>
                                    <td>
                                        
                                        @{
                                            var badgeClass = GetRoleBadgeClass(user.CurrentRole);
                                        }
                                        <span class="badge @badgeClass">@user.CurrentRole</span>
                                    </td>
                                    <td>
                                        <form asp-action="ChangeRole" method="post" class="d-flex justify-content-center role-form">
                                            <input type="hidden" name="userId" value="@user.UserId" />
                                            <select name="newRole" class="form-select me-2 role-select" style="width:180px;">

                                                @* Opción predeterminada para "Sin rol" *@
                                                @if (string.IsNullOrEmpty(user.CurrentRole) || user.CurrentRole == "Sin rol")
                                                {
                                                    <option value="" selected disabled>Seleccionar rol...</option>
                                                }

                                                @* Opciones de roles *@
                                                @foreach (var role in allRoles)
                                                {
                                                    <option value="@role"
                                                                                          selected="@(user.CurrentRole == role ? "selected" : null)">
                                                        @role
                                                    </option>
                                                }
                                            </select>

                                            @{
                                                // Asignar la clase inicial del botón al rol actual para que tenga el color correcto al cargar
                                                var initialButtonClass = GetRoleButtonClass(user.CurrentRole);
                                            }
                                            <button type="submit" class="btn @initialButtonClass btn-sm role-submit-btn">Guardar</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info text-center">No hay usuarios registrados para gestionar roles.</div>
            }

        </div> @* Cierre del card *@
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @* 4. Script para cambio dinámico de color del botón *@
    <script>
        $(document).ready(function () {
            // Función para obtener la clase de color del botón según el rol
            function getButtonClass(role) {
                switch (role) {
                    case 'Administrador':
                        return 'btn-primary';
                    case 'Entrenador':
                        return 'btn-success';
                    case 'Empleado':
                        return 'btn-info text-dark'; // Usar la clase text-dark con btn-info
                    case 'Miembro':
                        return 'btn-secondary';
                    default:
                        return 'btn-primary';
                }
            }

            // Escuchar el cambio en cualquier dropdown de roles
            $('.role-select').on('change', function () {
                var selectedRole = $(this).val();
                var $form = $(this).closest('.role-form');
                var $button = $form.find('.role-submit-btn');
                var newClass = getButtonClass(selectedRole);

                // Remover todas las clases de color existentes (btn-*) y añadir la nueva
                $button.removeClass('btn-primary btn-success btn-info text-dark btn-secondary').addClass(newClass);
            });
        });
    </script>
</body>
</html>