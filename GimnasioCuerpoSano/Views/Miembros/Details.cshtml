@model GimnasioCuerpoSano.Models.Miembro

@{
    Layout = null;
    ViewData["Title"] = "Detalles del Miembro";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body {
            background-color: #f8f9fa;
            padding: 2rem;
            font-family: 'Segoe UI', sans-serif;
        }

        .card {
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            background: white;
            padding: 2rem;
            max-width: 600px;
            margin: auto;
        }

        h2 {
            color: #0d6efd;
            margin-bottom: 1.5rem;
            text-align: center;
        }

        .form-label {
            font-weight: bold;
            color: #495057;
        }

        .value-box {
            background-color: #f1f3f5;
            border-radius: 6px;
            padding: 0.5rem 1rem;
            margin-bottom: 1rem;
        }

        .btn {
            border-radius: 8px;
        }
    </style>
</head>
<body>

    <div class="container">
        <div class="card">
            <h2>Detalles del Miembro</h2>

            <div class="mb-3">
                <label class="form-label">Nombre</label>
                <div class="value-box">@Model.Nombre</div>
            </div>

            <div class="mb-3">
                <label class="form-label">Apellido</label>
                <div class="value-box">@Model.Apellido</div>
            </div>

            <div class="mb-3">
                <label class="form-label">Dirección</label>
                <div class="value-box">@Model.Direccion</div>
            </div>

            <div class="mb-3">
                <label class="form-label">Teléfono</label>
                <div class="value-box">@Model.Telefono</div>
            </div>

            <div class="mb-3">
                <label class="form-label">Correo electrónico</label>
                <div class="value-box">@Model.Mail</div>
            </div>

            <div class="mb-3">
                <label class="form-label">Tipo de Membresía</label>
                <div class="value-box">@Model.Membresia?.Nombre</div>
            </div>


            <div class="mb-3">
                <label class="form-label">Descuento especial</label>
                <div class="value-box">@(Model.DescuentoEspecial ? "Sí (15%)" : "No")</div>
            </div>

            <div class="mb-3">
                <label class="form-label">Valor de la membresía</label>
                <div class="value-box">$@Model.ValorMembresia</div>
            </div>

            <div class="mb-3">
                <label class="form-label">Fecha de alta</label>
                <div class="value-box">@Model.FechaAlta.ToString("dd/MM/yyyy HH:mm")</div>
            </div>

            <div class="text-center mt-4">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary px-4">Editar</a>
                <a asp-action="Index" class="btn btn-secondary px-4 ms-2">Volver</a>
            </div>
        </div>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

