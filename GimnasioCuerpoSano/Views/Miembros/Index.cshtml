@model List<GimnasioCuerpoSano.Models.Miembro>

@{
    Layout = null;
    ViewData["Title"] = "Listado de Miembros";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/x-icon" href="~/img/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" />

    <style>
        body {
            background-color: #f8f9fa;
            padding: 2rem;
            font-family: 'Segoe UI', sans-serif;
        }

        .list-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 15px;
        }

        .header-logo {
            display: block;
            margin: 0 auto 15px auto;
            max-width: 100px;
            height: auto;
        }

        .card {
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            border-radius: 10px;
        }

        table {
            background: white;
            border-radius: 8px;
            overflow: hidden;
            border-collapse: separate;
            border-spacing: 0 10px;
        }

        thead tr {
            background-color: #f1f3f5;
        }

        th {
            background-color: #f1f3f5 !important;
            color: #212529 !important;
            text-align: center;
        }

        td {
            vertical-align: middle;
            border-bottom: 1px solid #dee2e6;
            padding: 1rem;
        }

        .btn {
            border-radius: 8px;
            font-weight: 500;
        }

        h2 {
            color: #212529;
            margin-bottom: 1.5rem;
            text-align: center;
            font-weight: 600;
        }
    </style>
</head>
<body>
    <div class="list-container">
        <img src="/img/Logo.png" alt="Logo Gimnasio Cuerpo Sano" class="header-logo text-center" />

        <div class="text-center mb-4">
            <h2>@ViewData["Title"]</h2>

            @if (TempData["Mensaje"] != null)
            {
                <div class="alert alert-success">@TempData["Mensaje"]</div>
            }

            <div class="d-flex justify-content-center align-items-center">
                @* Solo Administrador y Empleado pueden crear *@
                @if (User.IsInRole("Administrador") || User.IsInRole("Empleado"))
                {
                    <a asp-action="Create" class="btn btn-success me-2">
                        <i class="bi bi-person-plus"></i> Agregar nuevo miembro
                    </a>
                }

                @* PDF de miembros activos (visible para empleados y admin) *@
                @if (User.IsInRole("Administrador") || User.IsInRole("Empleado"))
                {
                    <a asp-action="ImprimirListado" class="btn btn-primary me-2" target="_blank">
                        <i class="bi bi-file-earmark-pdf"></i> Imprimir Listado Activos
                    </a>
                }

                @* PDF completo (solo Administrador) *@
                @if (User.IsInRole("Administrador"))
                {
                    <a asp-action="ImprimirListadoCompleto" class="btn btn-warning me-2" target="_blank">
                        <i class="bi bi-file-earmark-richtext"></i> Imprimir Completo (Admin)
                    </a>
                }

                <a asp-controller="Home" asp-action="Index" class="btn btn-secondary px-4">
                    <i class="bi bi-arrow-left"></i> Volver al Menú
                </a>
            </div>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive card p-3">
                <table class="table align-middle text-center">
                    <thead>
                        <tr>
                            <th>Tipo Doc</th>
                            <th>DNI</th>
                            <th>Nombre</th>
                            <th>Apellido</th>
                            <th>Dirección</th>
                            <th>Teléfono</th>
                            <th>Mail</th>
                            <th>Membresía</th>
                            <th>Dscto</th>
                            <th>Valor</th>
                            <th>F. Alta</th>
                            @if (User.IsInRole("Administrador") || User.IsInRole("Empleado"))
                            {
                                <th>Acciones</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.TipoDocumento</td>
                                <td>@item.DNI</td>
                                <td>@item.Nombre</td>
                                <td>@item.Apellido</td>
                                <td>@item.Direccion</td>
                                <td>@item.Telefono</td>
                                <td>@item.Mail</td>
                                <td>@item.Membresia?.Nombre</td>
                                <td>@(item.DescuentoEspecial ? "Sí" : "No")</td>
                                <td>$@item.ValorMembresia</td>
                                <td>@item.FechaAlta.ToString("dd/MM/yyyy HH:mm")</td>

                                @if (User.IsInRole("Administrador") || User.IsInRole("Empleado"))
                                {
                                    <td>
                                        <div class="d-grid gap-2 d-md-block">

                                            <!-- Botón Ver (siempre visible para admin y empleado) -->
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Ver</a>

                                            @if (User.IsInRole("Administrador"))
                                            {
                                                if (item.Activo)
                                                {
                                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Editar</a>
                                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Eliminar</a>
                                                }
                                                else
                                                {
                                                    <form asp-action="Reactivar" asp-route-id="@item.Id" method="post" style="display:inline;">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-success btn-sm">Reactivar</button>
                                                    </form>
                                                }
                                            }
                                            else if (User.IsInRole("Empleado"))
                                            {
                                                if (item.Activo)
                                                {
                                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Editar</a>
                                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Eliminar</a>
                                                }
                                            }
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info text-center">No hay miembros registrados.</div>
        }
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
