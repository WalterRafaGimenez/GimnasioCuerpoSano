@model List<GimnasioCuerpoSano.Models.Miembro>

@{
    Layout = null; // que no use layout
    ViewData["Title"] = "Listado de Miembros";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/x-icon" href="~/img/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" />

    <style>
                body {
                        background-color: #f8f9fa;
                        padding: 2rem;
                        font-family: 'Segoe UI', sans-serif;

        }

                .list-container {

            /* Usamos un ancho amplio, pero centrado */
                        max-width: 1400px;
                        margin: 0 auto;
                        padding: 0 15px;

        }


        /* Estilo para el logo (uniformidad) */
                .header-logo {
                        display: block;
                        margin: 0 auto 15px auto;
                        max-width: 100px; /* Tamaño unificado con Membresía */
                        height: auto;

        }

                .card {
                        box-shadow: 0 2px 8px rgba(0,0,0,0.1); /* Sombra consistente */
                        border-radius: 10px;

        }

                table {
                        background: white;
                        border-radius: 8px;
                        overflow: hidden;

            /* Aplicamos la estructura de tabla simple del listado de membresía */
                        border-collapse: separate;
                        border-spacing: 0 10px;

        }

                thead tr {
            background-color: #f1f3f5; /* Fondo más claro para el encabezado */
        }

        th {
            background-color: #f1f3f5 !important; /* Sobrescribir el azul si viene de site.css, usando el color unificado */
            color: #212529 !important;
            text-align: center;
        }

                td {
                        vertical-align: middle;
                        border-bottom: 1px solid #dee2e6;
                        padding: 1rem;

        }

                .btn {
                        border-radius: 8px;
                        font-weight: 500;

        }

                h2 {
                        color: #212529; /* Título oscuro y centrado */
                        margin-bottom: 1.5rem;
                        text-align: center;
                        font-weight: 600;

        }


    </style>
</head>
<body>

    <div class="list-container">
        @* LOGO UNIFICADO *@
        <img src="/img/Logo.png" alt="Logo Gimnasio Cuerpo Sano" class="header-logo text-center" />

        <div class="text-center mb-4">
            <h2>@ViewData["Title"]</h2>

            @if (TempData["Mensaje"] != null)
            {
                <div class="alert alert-success">@TempData["Mensaje"]</div>
            }

            <div class="d-flex justify-content-center align-items-center">
                @* Botones Globales (Verde=Crear, Azul=PDF, Gris=Volver) -> Correctos *@
                <a asp-action="Create" class="btn btn-success me-2">
                    <i class="bi bi-person-plus"></i> Agregar nuevo miembro
                </a>

                <a asp-action="ImprimirListado" class="btn btn-primary me-2" target="_blank">
                    <i class="bi bi-file-earmark-pdf"></i> Imprimir Listado PDF
                </a>

                <a asp-controller="Home" asp-action="Index" class="btn btn-secondary px-4">
                    <i class="bi bi-arrow-left"></i> Volver al Menú
                </a>
            </div>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive card p-3">
                @* Añadimos p-3 para separar la tabla de los bordes del card *@
                <table class="table align-middle text-center">
                    @* Eliminamos table-striped/table-bordered para el look unificado *@
                    <thead>
                        <tr>
                            @* Nombres de columnas abreviados para que quepa mejor en el ancho unificado *@
                            <th>Tipo Doc</th>
                            <th>DNI</th>
                            <th>Nombre</th>
                            <th>Apellido</th>
                            <th>Dirección</th>
                            <th>Teléfono</th>
                            <th>Mail</th>
                            <th>Membresía</th>
                            <th>Dscto</th> @* Abreviado por espacio *@
                            <th>Valor</th>
                            <th>F. Alta</th> @* Abreviado por espacio *@
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            var item = Model[i];
                            <tr>
                                <td>@item.TipoDocumento</td>
                                <td>@item.DNI</td>
                                <td>@item.Nombre</td>
                                <td>@item.Apellido</td>
                                <td>@item.Direccion</td>
                                <td>@item.Telefono</td>
                                <td>@item.Mail</td>
                                <td>@item.Membresia?.Nombre</td>
                                <td>@(item.DescuentoEspecial ? "Sí" : "No")</td>
                                <td>$@item.ValorMembresia</td>
                                <td>@item.FechaAlta.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <div class="d-grid gap-2 d-md-block">
                                        @* 🎨 Edit: De Amarillo a Azul (.btn-primary) 🎨 *@
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Editar</a>

                                        @* 🎨 Ver: De Azul claro a (.btn-info) 🎨 *@
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Ver</a>

                                        @* Eliminar: Se mantiene en Rojo (.btn-danger) *@
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Eliminar</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info text-center">No hay miembros registrados.</div>
        }

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
