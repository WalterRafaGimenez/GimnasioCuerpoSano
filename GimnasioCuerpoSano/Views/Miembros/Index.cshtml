@model List<GimnasioCuerpoSano.Models.Miembro>

<h2>Lista de Miembros</h2>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>Membresía</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @for (int i = 0; i < Model.Count; i++)
        {
            <tr>
                <td>@Model[i].Nombre</td>
                <td>@Model[i].Apellido</td>
                <td>@Model[i].TipoMembresia</td>
                <td>
                    <a asp-action="Details" asp-route-id="@i" class="btn btn-info btn-sm">Ver</a>
                    <a asp-action="Edit" asp-route-id="@i" class="btn btn-warning btn-sm">Editar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Create" class="btn btn-success">Nuevo Miembro</a>
