@model GimnasioCuerpoSano.Models.Miembro

@{
    Layout = null;
    ViewData["Title"] = "Eliminar Miembro";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/x-icon" href="~/img/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body {
            background-color: #f8f9fa;
            padding: 2rem;
            font-family: 'Segoe UI', sans-serif;
        }

        /* ✨ Estilo para el Logo ✨ */
        .header-logo {
            display: block;
            margin: 0 auto 15px auto; /* Centra horizontalmente y añade espacio abajo */
            max-width: 100px; /* Tamaño del logo ajustado */
            height: auto;
        }

        .card {
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            background: white;
            padding: 2rem;
            max-width: 600px;
            margin: auto;
        }

        h2 {
            color: #dc3545; /* Título en color rojo */
            margin-bottom: 1.5rem;
            text-align: center;
        }

        .form-label {
            font-weight: bold;
        }

        .value-box {
            background-color: #f1f3f5;
            border-radius: 6px;
            padding: 0.5rem 1rem;
            margin-bottom: 1rem;
        }

        .btn {
            border-radius: 8px;
        }
    </style>
</head>
<body>

    <div class="container">
        <div class="card">

            @* 🟢 ¡Logo Agregado! 🟢 *@
            <img src="/img/Logo.png" alt="Logo Gimnasio Cuerpo Sano" class="header-logo" />

            <h2 class="text-center">¿Eliminar este miembro?</h2>

            <div class="mb-3">
                <label class="form-label">Tipo de Documento</label>
                <div class="value-box">@Model.TipoDocumento</div>
            </div>

            <div class="mb-3">
                <label class="form-label">DNI</label>
                <div class="value-box">@Model.DNI</div>
            </div>

            <div class="mb-3">
                <label class="form-label">Nombre</label>
                <div class="value-box">@Model.Nombre</div>
            </div>

            <div class="mb-3">
                <label class="form-label">Apellido</label>
                <div class="value-box">@Model.Apellido</div>
            </div>

            <div class="mb-3">
                <label class="form-label">Tipo de Membresía</label>
                <div class="value-box">@Model.Membresia?.Nombre</div>
            </div>

            <div class="mb-3">
                <label class="form-label">Precio de Membresía</label>
                <div class="value-box">$@Model.Membresia?.Precio</div>
            </div>

            <div class="alert alert-warning text-center">
                <strong>Atención:</strong> esta acción no se puede deshacer.
            </div>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="text-center">
                    @* Botones correctos: Eliminar (Rojo) y Cancelar (Gris) *@
                    <button type="submit" class="btn btn-danger px-4">Eliminar</button>
                    <a asp-action="Index" class="btn btn-secondary px-4 ms-2">Cancelar</a>
                </div>
            </form>

        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
