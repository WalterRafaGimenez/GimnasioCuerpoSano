@model GimnasioCuerpoSano.Models.Miembro

@{
    Layout = null;
    ViewData["Title"] = "Editar Miembro";
}
@{
    var requiredAttr = string.IsNullOrEmpty(Model.Foto) ? "required" : null;
}


<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- Ícono del navegador -->
    <link rel="icon" type="image/x-icon" href="~/img/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body {
            background-color: #f8f9fa;
            padding: 2rem;
            font-family: 'Segoe UI', sans-serif;
        }

        h2 {
            color: #0d6efd;
            margin-bottom: 1.5rem;
        }

        .card {
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            padding: 2rem;
            background: white;
            max-width: 600px;
            margin: auto;
        }

        .btn {
            border-radius: 8px;
        }

        .info-text {
            font-size: 0.85rem;
            color: #6c757d;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="card">
            <h2 class="text-center">Editar Miembro</h2>

            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="TipoDocumento" class="form-label"></label>
                    <select asp-for="TipoDocumento" class="form-control" id="tipoDocumento">
                        <option value="DNI">DNI</option>
                        <option value="DNI-Extranjero">DNI Extranjero</option>
                    </select>
                    <span asp-validation-for="TipoDocumento" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="DNI" class="form-label"></label>
                    <input asp-for="DNI" class="form-control" id="dniInput" maxlength="12" />
                    <span asp-validation-for="DNI" class="text-danger"></span>
                    <div class="info-text">El DNI debe ser único para cada miembro.</div>
                </div>

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label"></label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Apellido" class="form-label"></label>
                    <input asp-for="Apellido" class="form-control" />
                    <span asp-validation-for="Apellido" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Direccion" class="form-label"></label>
                    <input asp-for="Direccion" class="form-control" />
                    <span asp-validation-for="Direccion" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Telefono" class="form-label"></label>
                    <input asp-for="Telefono" class="form-control" />
                    <span asp-validation-for="Telefono" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Mail" class="form-label"></label>
                    <input asp-for="Mail" class="form-control" />
                    <span asp-validation-for="Mail" class="text-danger"></span>
                    <div class="info-text">El correo electrónico debe ser único para cada miembro.</div>
                </div>

                <div class="mb-3">
                    <label asp-for="MembresiaId" class="form-label">Tipo de membresía</label>
                    <select asp-for="MembresiaId" class="form-control" asp-items="ViewBag.Membresias">
                        <option value="">Seleccione una membresía...</option>
                    </select>
                    <span asp-validation-for="MembresiaId" class="text-danger"></span>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="DescuentoEspecial" class="form-check-input" />
                    <label asp-for="DescuentoEspecial" class="form-check-label"></label>
                </div>

                <!-- FOTO OPCIONAL/OBLIGATORIA SEGÚN EXISTENCIA -->
                <div class="mb-3">
                    <label class="form-label">
                        Foto
                        @if (string.IsNullOrEmpty(Model.Foto))
                        {
                            <span class="text-danger">*</span>
                        }
                    </label>

                    @* Mostrar foto actual si existe *@
                    @if (!string.IsNullOrEmpty(Model.Foto))
                    {
                        <div class="mb-2">
                            <img src="@Model.Foto" alt="Foto actual" style="max-width:150px; max-height:150px; border-radius:5px;" />
                        </div>
                    }

                    <input type="file"
                           id="Foto"
                           name="fotoArchivo"
                           class="form-control"
                           accept="image/*" />

                    <span asp-validation-for="Foto" class="text-danger"></span>

                    @* Mensaje de aviso si no tiene foto y quiere guardar sin subir *@
                    @if (string.IsNullOrEmpty(Model.Foto))
                    {
                        <div class="form-text text-muted">Debe subir una foto si el miembro no tiene.</div>
                    }
                </div>




                <div class="text-center">
                    <button type="submit" class="btn btn-primary px-4">Guardar cambios</button>
                    <a asp-action="Index" class="btn btn-secondary px-4 ms-2">Cancelar</a>
                </div>
            </form>
        </div>
    </div>

    @section Scripts {
        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
        <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

        <script>
            const tipoDocumento = document.getElementById("tipoDocumento");
            const dniInput = document.getElementById("dniInput");
            const mailInput = document.querySelector('[asp-for="Mail"]');
            const dniErrorSpan = document.querySelector('[data-valmsg-for="DNI"]');
            const mailErrorSpan = document.querySelector('[data-valmsg-for="Mail"]');
            const form = document.querySelector("form");
            const miembroId = @Model.Id;

            tipoDocumento.addEventListener("change", () => {
                dniInput.value = "";
                dniErrorSpan.textContent = "";
                dniInput.setAttribute("maxlength", tipoDocumento.value === "DNI" ? "8" : "9");
                dniInput.focus();
            });

            dniInput.addEventListener("input", validarDNI);
            dniInput.addEventListener("blur", validarDNIAjax);
            mailInput.addEventListener("blur", validarMailAjax);

            dniInput.addEventListener("keypress", function (e) {
                const tipo = tipoDocumento.value;
                const key = e.key;
                if (tipo === "DNI" && !/[0-9]/.test(key)) e.preventDefault();
                else if (tipo === "DNI-Extranjero" && !/[0-9a-zA-Z]/.test(key)) e.preventDefault();
            });

            form.addEventListener("submit", function (e) {
                if (!validarDNI()) e.preventDefault();
            });

            function validarDNI() {
                const tipo = tipoDocumento.value;
                const dni = dniInput.value.trim();
                dniErrorSpan.textContent = "";

                if (!tipo) {
                    dniErrorSpan.textContent = "Seleccione el tipo de documento.";
                    return false;
                }

                const soloNumeros = /^\d{8}$/;
                const extranjero = /^\d{8}[A-Za-z0-9]{1}$/;

                if (tipo === "DNI" && !soloNumeros.test(dni)) {
                    dniErrorSpan.textContent = "El DNI nacional debe tener exactamente 8 números (sin letras ni símbolos).";
                    return false;
                } else if (tipo === "DNI-Extranjero" && !extranjero.test(dni)) {
                    dniErrorSpan.textContent = "El DNI extranjero debe tener 8 números seguidos de 1 letra o número (sin símbolos).";
                    return false;
                }

                return true;
            }

            function validarDNIAjax() {
                const dni = dniInput.value.trim();
                if (!dni) return;

                $.get('@Url.Action("CheckDNI", "Miembros")', { dni: dni, id: miembroId })
                    .done(function (res) {
                        dniErrorSpan.textContent = res.isUnique ? "" : "Este DNI ya está registrado.";
                    });
            }

            function validarMailAjax() {
                const mail = mailInput.value.trim();
                if (!mail) return;

                $.get('@Url.Action("CheckMail", "Miembros")', { mail: mail, id: miembroId })
                    .done(function (res) {
                        mailErrorSpan.textContent = res.isUnique ? "" : "Este correo ya está registrado.";
                    });
            }
        </script>
    }
</body>
</html>


