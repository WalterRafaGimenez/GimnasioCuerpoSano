@model GimnasioCuerpoSano.Models.Miembro

@{
    Layout = null;
    ViewData["Title"] = "Alta de Miembro";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- Ícono del navegador -->
    <link rel="icon" type="image/x-icon" href="~/img/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body {
            background-color: #f8f9fa;
            padding: 2rem;
            font-family: 'Segoe UI', sans-serif;
        }

        h2 {
            color: #198754;
            margin-bottom: 1.5rem;
        }

        .card {
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            padding: 2rem;
            background: white;
            max-width: 600px;
            margin: auto;
        }

        .btn {
            border-radius: 8px;
        }

        .info-text {
            font-size: 0.85rem;
            color: #6c757d;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="card">
            <h2 class="text-center">Alta de Miembro</h2>

            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label"></label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Apellido" class="form-label"></label>
                    <input asp-for="Apellido" class="form-control" />
                    <span asp-validation-for="Apellido" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Direccion" class="form-label"></label>
                    <input asp-for="Direccion" class="form-control" />
                    <span asp-validation-for="Direccion" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Telefono" class="form-label"></label>
                    <input asp-for="Telefono" class="form-control" />
                    <span asp-validation-for="Telefono" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Mail" class="form-label"></label>
                    <input asp-for="Mail" class="form-control" />
                    <span asp-validation-for="Mail" class="text-danger"></span>
                    <div class="info-text">El correo electrónico debe ser único para cada miembro.</div>
                </div>

                <div class="mb-3">
                    <label asp-for="MembresiaId" class="form-label">Tipo de membresía</label>
                    <select asp-for="MembresiaId" class="form-control" asp-items="ViewBag.Membresias">
                        <option value="">Seleccione una membresía...</option>
                    </select>
                    <span asp-validation-for="MembresiaId" class="text-danger"></span>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="DescuentoEspecial" class="form-check-input" />
                    <label asp-for="DescuentoEspecial" class="form-check-label"></label>
                </div>

                <div class="form-group">
                    <label asp-for="TipoDocumento" class="control-label"></label>
                    <select asp-for="TipoDocumento" class="form-control" id="tipoDocumento">
                        <option value="DNI">DNI</option>
                        <option value="DNI-Extranjero">DNI Extranjero</option>
                    </select>
                    <span asp-validation-for="TipoDocumento" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="DNI" class="control-label"></label>
                    <input asp-for="DNI" class="form-control" id="dniInput" maxlength="12" />
                    <span asp-validation-for="DNI" class="text-danger"></span>
                    <div class="info-text">El DNI debe ser único para cada miembro.</div>
                </div>

                <!-- FOTO OPCIONAL -->
                <div class="mb-3">
                    <label for="fotoArchivo" class="form-label">Foto (opcional)</label>
                    <input type="file" name="fotoArchivo" class="form-control" accept="image/*" />
                </div>

                <!-- CÓDIGO DE BARRA OCULTO -->
                <input type="hidden" asp-for="CodigoBarra" />

                <div class="text-center">
                    <button type="submit" class="btn btn-success px-4">Guardar</button>
                    <a asp-action="Index" class="btn btn-secondary px-4 ms-2">Volver</a>
                </div>
            </form>
        </div>
    </div>



    @section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        const tipoDocumento = document.getElementById("tipoDocumento");
        const dniInput = document.getElementById("dniInput");
        const mailInput = document.getElementById("Mail");
        const errorSpan = document.querySelector('[data-valmsg-for="DNI"]');
        const mailSpan = document.querySelector('[data-valmsg-for="Mail"]');
        const form = document.querySelector("form");

        // Cambiar tipo de documento
        tipoDocumento.addEventListener("change", () => {
            dniInput.value = "";
            errorSpan.textContent = "";
            dniInput.setAttribute("maxlength", tipoDocumento.value === "DNI" ? "8" : "9");
            dniInput.focus();
        });

        // Validación en tiempo real
        dniInput.addEventListener("input", validarDNI);

        dniInput.addEventListener("keypress", function (e) {
            const tipo = tipoDocumento.value;
            const key = e.key;
            if (tipo === "DNI" && !/[0-9]/.test(key)) e.preventDefault();
            if (tipo === "DNI-Extranjero" && !/[0-9a-zA-Z]/.test(key)) e.preventDefault();
        });

        // --- AJAX Validación DNI ---
        dniInput.addEventListener("blur", function(){
            const dni = dniInput.value.trim();
            if(dni){
                $.get('@Url.Action("CheckDNI", "Miembro")', { dni: dni }, function(result){
                    if(result.exists){
                        errorSpan.textContent = "Este DNI ya está registrado.";
                        errorSpan.style.color = "red";
                    } else {
                        errorSpan.textContent = "";
                    }
                });
            }
        });

        // --- AJAX Validación Mail ---
        mailInput.addEventListener("blur", function(){
            const mail = mailInput.value.trim();
            if(mail){
                $.get('@Url.Action("CheckMail", "Miembro")', { mail: mail }, function(result){
                    if(result.exists){
                        mailSpan.textContent = "Este correo ya está registrado.";
                        mailSpan.style.color = "red";
                    } else {
                        mailSpan.textContent = "";
                    }
                });
            }
        });

        // Validación al enviar
        form.addEventListener("submit", function (e) {
            const valido = validarDNI();
            if (!valido) {
                e.preventDefault();
                dniInput.focus();
            }

            if(mailSpan.textContent === "Este correo ya está registrado.") {
                e.preventDefault();
                mailInput.focus();
            }
        });

        function validarDNI() {
            const tipo = tipoDocumento.value;
            const dni = dniInput.value.trim();
            errorSpan.textContent = "";

            if (!tipo) {
                errorSpan.textContent = "Seleccione el tipo de documento.";
                return false;
            }

            const soloNumeros = /^\d{8}$/;
            const extranjero = /^\d{8}[A-Za-z0-9]{1}$/;

            if (tipo === "DNI" && !soloNumeros.test(dni)) {
                errorSpan.textContent = "El DNI nacional debe tener exactamente 8 números (sin letras ni símbolos).";
                return false;
            }

            if (tipo === "DNI-Extranjero" && !extranjero.test(dni)) {
                errorSpan.textContent = "El DNI extranjero debe tener 8 números seguidos de 1 letra o número (sin símbolos).";
                return false;
            }

            return true;
        }
    </script>
}

    }
</body>
</html>

