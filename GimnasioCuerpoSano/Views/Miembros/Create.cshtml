@model GimnasioCuerpoSano.Models.Miembro

@{
    Layout = null;
    ViewData["Title"] = "Alta de Miembro";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/x-icon" href="~/img/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body {
            background-color: #f8f9fa;
            padding: 2rem;
            font-family: 'Segoe UI', sans-serif;
        }

        /* ✨ Nuevo Estilo para el Logo ✨ */
        .header-logo {
            display: block;
            margin: 0 auto 15px auto; /* Centra horizontalmente y añade espacio abajo */
            max-width: 100px; /* Tamaño del logo ajustado */
            height: auto;
        }

        h2 {
            color: #198754;
            margin-bottom: 1.5rem;
        }

        .card {
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            padding: 2rem;
            background: white;
            max-width: 600px;
            margin: auto;
        }

        .btn {
            border-radius: 8px;
        }

        .info-text {
            font-size: 0.85rem;
            color: #6c757d;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="card">

            @* 🟢 ¡Logo Agregado! 🟢 *@
            <img src="/img/Logo.png" alt="Logo Gimnasio Cuerpo Sano" class="header-logo" />

            <h2 class="text-center">@ViewData["Title"]</h2>

            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label"></label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Apellido" class="form-label"></label>
                    <input asp-for="Apellido" class="form-control" />
                    <span asp-validation-for="Apellido" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Direccion" class="form-label"></label>
                    <input asp-for="Direccion" class="form-control" />
                    <span asp-validation-for="Direccion" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Telefono" class="form-label"></label>
                    <input asp-for="Telefono" class="form-control" />
                    <span asp-validation-for="Telefono" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Mail" class="form-label"></label>
                    <input asp-for="Mail" class="form-control" />
                    <span asp-validation-for="Mail" class="text-danger"></span>
                    <div class="info-text">El correo electrónico debe ser único para cada miembro.</div>
                </div>

                <div class="mb-3">
                    <label asp-for="MembresiaId" class="form-label">Tipo de membresía</label>
                    <select asp-for="MembresiaId" class="form-control" asp-items="ViewBag.Membresias">
                        <option value="">Seleccione una membresía...</option>
                    </select>
                    <span asp-validation-for="MembresiaId" class="text-danger"></span>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="DescuentoEspecial" class="form-check-input" />
                    <label asp-for="DescuentoEspecial" class="form-check-label"></label>
                </div>

                <div class="form-group">
                    <label asp-for="TipoDocumento" class="control-label"></label>
                    <select asp-for="TipoDocumento" class="form-control" id="tipoDocumento">
                        <option value="DNI">DNI</option>
                        <option value="DNI-Extranjero">DNI Extranjero</option>
                    </select>
                    <span asp-validation-for="TipoDocumento" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="DNI" class="control-label"></label>
                    <input asp-for="DNI" class="form-control" id="dniInput" maxlength="12" />
                    <span asp-validation-for="DNI" class="text-danger"></span>
                    <div class="info-text">El DNI debe ser único para cada miembro.</div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Foto <span class="text-danger">*</span></label>
                    <input type="file" name="fotoArchivo" class="form-control" accept="image/*" required />
                    <span asp-validation-for="Foto" class="text-danger"></span>
                </div>

                <input type="hidden" asp-for="CodigoBarra" />

                <div class="text-center">
                    @* Botones correctos: Guardar (Verde) y Volver (Gris) *@
                    <button type="submit" class="btn btn-success px-4">Guardar</button>
                    <a asp-action="Index" class="btn btn-secondary px-4 ms-2">Volver</a>
                </div>
            </form>
        </div>
    </div>

    @* Mantenemos los scripts de validación *@
    @section Scripts {
        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
        <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

        <script>
            // ... (Tu código JavaScript de validación se mantiene igual) ...
        </script>
    }
</body>
</html>
