@model GimnasioCuerpoSano.Models.ViewModels.MisClasesEntrenadorViewModel

@{
    Layout = null;
    ViewData["Title"] = "Mis Clases";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/x-icon" href="~/img/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
                body {
                        background-color: #f8f9fa;
                        font-family: 'Segoe UI', sans-serif;
                        padding: 2rem;

        }


        /* Estilos para el Encabezado (Unificado) */
                .main-header {
                        text-align: center;
                        margin-top: 1rem;
                        margin-bottom: 2rem;

        }

                    .main-header .logo {
                            width: 100px;
                            height: auto;
                            margin-bottom: 5px;

        }

                    .main-header .page-title {
                            color: #212529;
                            font-weight: 700;
                            font-size: 2rem;

        }






        /* Estilo para centrar el botón Volver */
                .top-action {
                        margin-bottom: 1.5rem;

        }

                .card {
                        border: none; /* Quitamos bordes si no son necesarios */

        }


    </style>
</head>
<body class="bg-light">
    <div class="container mt-4">

        @* AÑADIDO: Logo y Título principal al inicio *@
        <div class="main-header">
            <img src="~/img/Logo.png" alt="Logo Cuerpo Sano" class="logo" />
            <h1 class="page-title">@ViewData["Title"]</h1>
        </div>

        @* Información del certificado debajo del título principal *@
        <div class="text-center mb-3">
            <p class="h5 mb-3">
                Certificado Vto:
                @if (Model.FechaVencimientoCertificado.HasValue)
                {
                    var vencido = Model.FechaVencimientoCertificado.Value.Date < DateTime.Today;
                    <span class="fw-bold @(vencido ? "text-danger" : "text-dark")">
                        @Model.FechaVencimientoCertificado.Value.ToString("dd/MM/yyyy")
                        @(vencido ? " (VENCIDO)" : "")
                    </span>
                }
                else
                {
                    <span class="text-muted">No registrado</span>
                }
            </p>
        </div>

        @* MOVIDO: Botón "Volver" arriba de la tabla de listado *@
        <div class="d-flex justify-content-center top-action">
            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left-circle"></i> Volver
            </a>
        </div>

        <div class="card shadow-lg p-3 rounded-4">
            <div class="table-responsive">
                <table class="table table-bordered table-striped text-center align-middle mb-0">
                    <thead class="table-light">
                        @* RESTAURADO: Se mantiene el estilo table-light *@
                        <tr>
                            <th>Clase</th>
                            <th>Sala</th>
                            <th>Día</th>
                            <th>Hora Inicio</th>
                            <th>Hora Fin</th>
                            <th>Duración (min)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Clases != null && Model.Clases.Any())
                        {
                            foreach (var clase in Model.Clases)
                            {
                                <tr>
                                    <td><strong>@clase.NombreClase</strong></td>
                                    <td>@clase.SalaNombre</td>
                                    <td>@clase.DiaSemana</td>
                                    <td>@clase.HoraInicio.ToString(@"hh\:mm")</td>
                                    <td>@clase.HoraFin.ToString(@"hh\:mm")</td>
                                    <td>@clase.DuracionMinutos</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-muted text-center py-3">
                                    No tienes clases asignadas actualmente.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>